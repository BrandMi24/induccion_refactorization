@model induccion_refactorization.ViewModels.PagedResult<induccion_refactorization.ViewModels.AspiranteResumenViewModel>
@{
    ViewBag.Title = "Mis Aspirantes";
    bool puedeCrear = ViewBag.PuedeCrear;
}

@{
    var importCreados = TempData["ImportCreados"] as List<string>;
    var importErrores = TempData["ImportErrores"] as List<string>;
    bool credencialesListas = TempData["CredencialesListas"] as bool? ?? false;
}

<div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <a href="@Url.Action("Index", "Coordinador")" class="btn btn-link ps-0">
            <i class="fas fa-arrow-left"></i> Volver al Panel
        </a>
        <h2 class="mb-1"><i class="fas fa-user-graduate text-primary"></i> Mis Aspirantes</h2>
        <p class="text-muted mb-0">Aspirantes de tu(s) carrera(s) asignada(s) y su avance; los que tienen entregas pendientes por revisar aparecen primero.</p>
    </div>
    @if (puedeCrear)
    {
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalCargaMasiva">
            <i class="fas fa-file-excel"></i> Carga Masiva
        </button>
    }
</div>

@if (importCreados != null && importCreados.Any())
{
    <div class="alert alert-success">
        <strong><i class="fas fa-check-circle"></i> Aspirantes creados (@importCreados.Count):</strong>
        <ul class="mb-0 mt-2 small">
            @foreach (var linea in importCreados)
            {
                <li>@linea</li>
            }
        </ul>
        @if (credencialesListas)
        {
            <a href="@Url.Action("DescargarCredencialesGeneradas", "Coordinador")" class="btn btn-sm btn-success mt-2">
                <i class="fas fa-file-excel"></i> Descargar Credenciales (Excel)
            </a>
        }
    </div>
}
@if (importErrores != null && importErrores.Any())
{
    <div class="alert alert-warning">
        <strong><i class="fas fa-exclamation-triangle"></i> Filas con errores (@importErrores.Count):</strong>
        <ul class="mb-0 mt-2 small">
            @foreach (var linea in importErrores)
            {
                <li>@linea</li>
            }
        </ul>
    </div>
}

<div class="row mb-4 g-3">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="icon-badge icon-badge-primary"><i class="fas fa-user-graduate"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.TotalAspirantes</div>
                <div class="stat-card-label">Aspirantes</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="icon-badge icon-badge-success"><i class="fas fa-chart-line"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.PromedioAvance%</div>
                <div class="stat-card-label">Avance Promedio</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="icon-badge icon-badge-danger"><i class="fas fa-undo"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.EntregasDevueltas</div>
                <div class="stat-card-label">Entregas Devueltas</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="icon-badge icon-badge-info"><i class="fas fa-clipboard-check"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.EntregasPendientesCalificar</div>
                <div class="stat-card-label">Entregas por Revisar</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        @using (Html.BeginForm("MisAspirantes", "Coordinador", FormMethod.Get))
        {
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label small text-muted mb-1">Buscar</label>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm"
                           placeholder="Nombre o folio..." />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                        <i class="fas fa-search"></i> Filtrar
                    </button>
                    <a href="@Url.Action("MisAspirantes", "Coordinador")" class="btn btn-sm btn-outline-secondary btn-icon" title="Limpiar filtros">
                        <i class="fas fa-times"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Aspirantes</h5>
        <small class="text-muted">@Model.TotalCount resultado(s)</small>
    </div>
    <div class="card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-clean mb-0">
                    <thead>
                        <tr>
                            @{
                                var sortRouteValues = new System.Web.Routing.RouteValueDictionary(new { search = ViewBag.Search });
                            }
                            <th>
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Aspirante", SortField = "Aspirante", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "MisAspirantes", Controller = "Coordinador", RouteValues = sortRouteValues
                                })
                            </th>
                            <th>Materias</th>
                            <th class="text-center">
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Pendientes por Revisar", SortField = "Pendientes", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "MisAspirantes", Controller = "Coordinador", RouteValues = sortRouteValues
                                })
                            </th>
                            <th class="text-center">
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Progreso", SortField = "Progreso", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "MisAspirantes", Controller = "Coordinador", RouteValues = sortRouteValues
                                })
                            </th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td data-label="Aspirante">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="icon-badge icon-badge-sm icon-badge-primary">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@(item.Aspirante.NombreCompleto)</div>
                                            <small class="text-muted">Folio: @(item.Aspirante.NombreUsuario)</small>
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Materias">
                                    @if (item.Materias.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            @foreach (var materia in item.Materias)
                                            {
                                                var claseSemaforo = materia.Semaforo == "completo" ? "bg-success"
                                                    : materia.Semaforo == "parcial" ? "bg-warning text-dark" : "bg-danger";
                                                <span class="badge @claseSemaforo" title="@materia.Nombre (@materia.UnidadesRevisadas/@materia.TotalUnidades revisadas)">
                                                    @materia.Abreviatura
                                                </span>
                                            }
                                            <small class="text-muted ms-1">@item.MateriasCompletas/@item.TotalMaterias completas</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin unidades asignadas</span>
                                    }
                                </td>
                                <td class="text-center" data-label="Pendientes por Revisar">
                                    @if (item.EntregasPendientes > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@item.EntregasPendientes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">0</span>
                                    }
                                </td>
                                <td class="text-center" data-label="Progreso">
                                    <div class="d-flex align-items-center gap-2 justify-content-center">
                                        <div class="progress flex-grow-1" style="height: 8px; max-width: 120px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @(item.PorcentajeProgreso)%;"></div>
                                        </div>
                                        <small class="text-muted">@item.PorcentajeProgreso% (@item.UnidadesCompletadas/@item.TotalUnidadesAsignadas)</small>
                                    </div>
                                </td>
                                <td class="text-end" data-label="Acciones">
                                    <a href="@Url.Action("AspiranteDetalle", new { id = item.Aspirante.UsuarioID })"
                                       class="btn btn-sm btn-primary" title="Ver detalle">
                                        <i class="fas fa-eye"></i> Ver Detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @Html.Partial("_Pager", new induccion_refactorization.ViewModels.PagerViewModel
            {
                PageNumber = Model.PageNumber,
                TotalPages = Model.TotalPages,
                PageSize = Model.PageSize,
                Action = "MisAspirantes",
                Controller = "Coordinador",
                RouteValues = new System.Web.Routing.RouteValueDictionary(new { search = ViewBag.Search, sortBy = ViewBag.SortBy, sortDir = ViewBag.SortDir })
            })
        }
        else
        {
            <div class="empty-state">
                <div class="icon-badge icon-badge-lg icon-badge-info">
                    <i class="fas fa-user-graduate"></i>
                </div>
                <div class="empty-state-title">No hay aspirantes en tu carrera todavía</div>
                <p class="mb-0">Cuando el Administrador asigne aspirantes a tu carrera, aparecerán aquí.</p>
            </div>
        }
    </div>
</div>

@* ===================== Modal: Carga Masiva de Aspirantes ===================== *@
<div class="modal fade" id="modalCargaMasiva" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-file-excel"></i> Carga Masiva de Aspirantes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">
                    Descarga la plantilla, llénala con los datos de cada aspirante (una fila por persona) y
                    súbela aquí. Las columnas <strong>Carrera 1 / 2 / 3</strong> son un desplegable con tus
                    carreras a cargo — elige hasta 3. El Área se asigna automáticamente según la primera
                    carrera de cada fila. No se pide Folio ni Nombre de Usuario: su Folio (y nombre de
                    usuario) se genera automáticamente, consecutivo al último folio del sistema. Al terminar
                    la importación podrás descargar un Excel con las credenciales de cada cuenta creada.
                </p>
                <a href="@Url.Action("DescargarPlantillaAspirantes", "Coordinador")" class="btn btn-sm btn-outline-secondary mb-3">
                    <i class="fas fa-download"></i> Descargar Plantilla (Excel)
                </a>
                @using (Html.BeginForm("ImportarAspirantesMasivo", "Coordinador", FormMethod.Post, new { enctype = "multipart/form-data", @class = "carga-masiva-form" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-0">
                        <label class="form-label">Archivo (.xlsx)</label>
                        <input type="file" name="archivo" class="form-control" accept=".xlsx" required />
                    </div>
                    <div class="modal-footer px-0 pb-0 mt-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-upload"></i> Importar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $('.carga-masiva-form').on('submit', function () {
            var $btn = $(this).find('button[type="submit"]');
            $btn.prop('disabled', true);
            $btn.html('<i class="fas fa-spinner fa-spin"></i> Importando...');
        });
    </script>
}
