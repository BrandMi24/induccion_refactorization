@model induccion_refactorization.ViewModels.PagedResult<induccion_refactorization.ViewModels.AspiranteResumenViewModel>
@{
    ViewBag.Title = "Mis Aspirantes";
}

<div class="mb-4">
    <a href="@Url.Action("Index", "Coordinador")" class="btn btn-link ps-0">
        <i class="fas fa-arrow-left"></i> Volver al Panel
    </a>
    <h2 class="mb-1"><i class="fas fa-user-graduate text-primary"></i> Mis Aspirantes</h2>
    <p class="text-muted mb-0">Aspirantes de tu(s) carrera(s) asignada(s) y su avance.</p>
</div>

<div class="row mb-4 g-3">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="icon-badge icon-badge-primary"><i class="fas fa-user-graduate"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.TotalAspirantes</div>
                <div class="stat-card-label">Aspirantes</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="icon-badge icon-badge-success"><i class="fas fa-chart-line"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.PromedioAvance%</div>
                <div class="stat-card-label">Avance Promedio</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="icon-badge icon-badge-warning"><i class="fas fa-list-check"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.UnidadesPendientesCalificar</div>
                <div class="stat-card-label">Unidades por Calificar</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="icon-badge icon-badge-info"><i class="fas fa-clipboard-check"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.EntregasPendientesCalificar</div>
                <div class="stat-card-label">Entregas por Calificar</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        @using (Html.BeginForm("MisAspirantes", "Coordinador", FormMethod.Get))
        {
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label small text-muted mb-1">Buscar</label>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm"
                           placeholder="Nombre, matrícula o folio..." />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                        <i class="fas fa-search"></i> Filtrar
                    </button>
                    <a href="@Url.Action("MisAspirantes", "Coordinador")" class="btn btn-sm btn-outline-secondary btn-icon" title="Limpiar filtros">
                        <i class="fas fa-times"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Aspirantes</h5>
        <small class="text-muted">@Model.TotalCount resultado(s)</small>
    </div>
    <div class="card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-clean mb-0">
                    <thead>
                        <tr>
                            @{
                                var sortRouteValues = new System.Web.Routing.RouteValueDictionary(new { search = ViewBag.Search });
                            }
                            <th>
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Aspirante", SortField = "Aspirante", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "MisAspirantes", Controller = "Coordinador", RouteValues = sortRouteValues
                                })
                            </th>
                            <th class="text-center">
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Progreso", SortField = "Progreso", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "MisAspirantes", Controller = "Coordinador", RouteValues = sortRouteValues
                                })
                            </th>
                            <th class="text-center">
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Promedio", SortField = "Promedio", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "MisAspirantes", Controller = "Coordinador", RouteValues = sortRouteValues
                                })
                            </th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td data-label="Aspirante">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="icon-badge icon-badge-sm icon-badge-primary">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@(item.Aspirante.Usuario?.NombreCompleto)</div>
                                            <small class="text-muted">Folio: @(item.Aspirante.Folio ?? "N/A")</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center" data-label="Progreso">
                                    <div class="d-flex align-items-center gap-2 justify-content-center">
                                        <div class="progress flex-grow-1" style="height: 8px; max-width: 120px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @(item.PorcentajeProgreso)%;"></div>
                                        </div>
                                        <small class="text-muted">@item.PorcentajeProgreso% (@item.UnidadesCompletadas/@item.TotalUnidadesAsignadas)</small>
                                    </div>
                                </td>
                                <td class="text-center" data-label="Promedio">
                                    @(item.PromedioCalificacion.HasValue ? item.PromedioCalificacion.Value.ToString("F2") : "N/A")
                                </td>
                                <td class="text-end" data-label="Acciones">
                                    <a href="@Url.Action("AspiranteDetalle", new { id = item.Aspirante.AspiranteID })"
                                       class="btn btn-sm btn-primary" title="Ver detalle">
                                        <i class="fas fa-eye"></i> Ver Detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @Html.Partial("_Pager", new induccion_refactorization.ViewModels.PagerViewModel
            {
                PageNumber = Model.PageNumber,
                TotalPages = Model.TotalPages,
                PageSize = Model.PageSize,
                Action = "MisAspirantes",
                Controller = "Coordinador",
                RouteValues = new System.Web.Routing.RouteValueDictionary(new { search = ViewBag.Search, sortBy = ViewBag.SortBy, sortDir = ViewBag.SortDir })
            })
        }
        else
        {
            <div class="empty-state">
                <div class="icon-badge icon-badge-lg icon-badge-info">
                    <i class="fas fa-user-graduate"></i>
                </div>
                <div class="empty-state-title">No hay aspirantes en tu carrera todavía</div>
                <p class="mb-0">Cuando el Administrador asigne aspirantes a tu carrera, aparecerán aquí.</p>
            </div>
        }
    </div>
</div>
