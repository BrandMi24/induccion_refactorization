@{
    var rolIdSesion = Session["RolID"] != null ? (int)Session["RolID"] : 0;
    var tituloPanel = rolIdSesion == 5 ? "Panel de Maestro" : "Panel de Coordinación";
    ViewBag.Title = tituloPanel;
}

<div class="mb-4">
    <h2 class="mb-1"><i class="fas fa-users-cog text-primary"></i> @tituloPanel</h2>
    <p class="text-muted mb-0">Bienvenido, <strong>@ViewBag.NombreCompleto</strong></p>
</div>

<div class="row mb-4 g-3">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="icon-badge icon-badge-warning">
                <i class="fas fa-clipboard-list"></i>
            </div>
            <div>
                <div class="stat-card-value">@ViewBag.PendientesCount</div>
                <div class="stat-card-label">Pendientes de Revisión</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="icon-badge icon-badge-success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div>
                <div class="stat-card-value">@ViewBag.RevisadasCount</div>
                <div class="stat-card-label">Entregas Aprobadas</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="icon-badge icon-badge-danger">
                <i class="fas fa-times-circle"></i>
            </div>
            <div>
                <div class="stat-card-value">@ViewBag.RechazadasCount</div>
                <div class="stat-card-label">Entregas Devueltas</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="icon-badge icon-badge-primary">
                <i class="fas fa-book"></i>
            </div>
            <div>
                <div class="stat-card-value">@ViewBag.TotalMaterias</div>
                <div class="stat-card-label">Materias Activas</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="action-card">
            <div class="icon-badge icon-badge-lg icon-badge-primary">
                <i class="fas fa-book"></i>
            </div>
            <h5 class="action-card-title">Gestión de Contenido</h5>
            <p class="action-card-text">Crear y editar materias, unidades y entregables de inducción.</p>
            <a href="@Url.Action("Index", "InductionMaintenance")" class="btn btn-primary">
                Ir a Gestión <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="action-card">
            <div class="icon-badge icon-badge-lg icon-badge-success">
                <i class="fas fa-user-graduate"></i>
            </div>
            <h5 class="action-card-title">Mis Aspirantes</h5>
            <p class="action-card-text">Ver a tus aspirantes, su avance, y revisar o asignar unidades.</p>
            @if ((int)(ViewBag.PendientesCount ?? 0) > 0)
            {
                <span class="badge bg-danger align-self-start mb-1">@ViewBag.PendientesCount pendientes</span>
            }
            <a href="@Url.Action("MisAspirantes", "Coordinador")" class="btn btn-success">
                Ir a Aspirantes <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    @if (rolIdSesion == 3)
    {
        <div class="col-md-6">
            <div class="action-card">
                <div class="icon-badge icon-badge-lg icon-badge-secondary">
                    <i class="fas fa-chalkboard-teacher"></i>
                </div>
                <h5 class="action-card-title">Mis Maestros</h5>
                <p class="action-card-text">Ver a los Maestros de tu carrera y un reporte de su actividad.</p>
                <a href="@Url.Action("MisMaestros", "Coordinador")" class="btn btn-secondary">
                    Ir a Maestros <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    }
</div>
