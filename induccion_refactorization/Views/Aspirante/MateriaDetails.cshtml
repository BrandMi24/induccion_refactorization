@model induccion_refactorization.Models.Ind_Materia
@{
    ViewBag.Title = "Contenido de la Materia";
    var progresoRecords = ViewBag.ProgresoRecords as List<induccion_refactorization.Models.Ind_ProgresoAspirante>;
    var submisiones = ViewBag.Submisiones as List<induccion_refactorization.Models.Ind_Submision>;
    var unidadesOrdenadas = (Model.Ind_Unidades ?? new List<induccion_refactorization.Models.Ind_Unidad>()).OrderBy(u => u.Orden).ToList();
}
@functions {
    // Una unidad "necesita acción" cuando el maestro devolvió alguno de sus
    // entregables y el aspirante todavía no ha vuelto a subir nada más reciente
    // (progreso.Estado se queda en "Entregado" hasta que se resuelva).
    bool TieneEntregableDevuelto(induccion_refactorization.Models.Ind_Unidad unidad, List<induccion_refactorization.Models.Ind_Submision> submisiones)
    {
        if (submisiones == null) { return false; }
        var entregableIds = (unidad.Ind_Entregables ?? new List<induccion_refactorization.Models.Ind_Entregable>())
            .Where(e => e.Activo).Select(e => e.EntregableID).ToList();
        return submisiones.Any(s => entregableIds.Contains(s.EntregableID) && s.Estado == "Rechazado");
    }
}

<div class="mb-3">
    <a href="@Url.Action("Index", "Aspirante")" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left"></i> Volver a Mis Cursos
    </a>
</div>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-book-open"></i> @ViewBag.MateriaNombre</h5>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">@ViewBag.MateriaDescripcion</p>

        @{ var materiaCompletada = false; }
        @if (unidadesOrdenadas.Any())
        {
            var totalUnidades = unidadesOrdenadas.Count;
            var unidadesCompletadas = progresoRecords?.Count(p => p.Estado == "Revisado") ?? 0;
            var porcentajeTotal = totalUnidades > 0 ? (int)((unidadesCompletadas * 100.0) / totalUnidades) : 0;
            materiaCompletada = totalUnidades > 0 && unidadesCompletadas == totalUnidades;

            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-semibold">Progreso General</span>
                <span class="small text-muted">@unidadesCompletadas de @totalUnidades unidades</span>
            </div>
            <div class="progress" style="height: 10px;">
                <div class="progress-bar" role="progressbar" style="width: @porcentajeTotal%;"
                     aria-valuenow="@porcentajeTotal" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        }
    </div>
</div>

@if (unidadesOrdenadas.Any())
{
    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card unidad-list-card">
                <div class="card-header">
                    <h6 class="mb-0">Unidades</h6>
                </div>
                <div class="list-group list-group-flush unidad-list" id="unidadList">
                    @for (var i = 0; i < unidadesOrdenadas.Count; i++)
                    {
                        var unidad = unidadesOrdenadas[i];
                        var progreso = progresoRecords?.FirstOrDefault(p => p.UnidadID == unidad.UnidadID);
                        var estadoClass = "secondary";
                        var estadoIcon = "fa-circle";

                        if (progreso != null)
                        {
                            switch (progreso.Estado)
                            {
                                case "Asignado": estadoClass = "info"; estadoIcon = "fa-tasks"; break;
                                case "Entregado": estadoClass = "warning"; estadoIcon = "fa-hourglass-half"; break;
                                case "Revisado": estadoClass = "success"; estadoIcon = "fa-check-circle"; break;
                            }
                        }

                        if (TieneEntregableDevuelto(unidad, submisiones))
                        {
                            estadoClass = "danger";
                            estadoIcon = "fa-exclamation-triangle";
                        }

                        <a href="#" class="list-group-item list-group-item-action unidad-list-item @(i == 0 ? "active" : "")"
                           data-target="unidad-panel-@unidad.UnidadID" onclick="return selectUnidad(this, event);">
                            <div class="d-flex justify-content-between align-items-center">
                                <span><small class="text-muted">@unidad.Orden.</small> @unidad.Nombre</span>
                                <span class="status-icon status-icon-@estadoClass ms-2"><i class="fas @estadoIcon"></i></span>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            @for (var i = 0; i < unidadesOrdenadas.Count; i++)
            {
                var unidad = unidadesOrdenadas[i];
                var progreso = progresoRecords?.FirstOrDefault(p => p.UnidadID == unidad.UnidadID);
                var estadoClass = "secondary";
                var estadoTexto = "Pendiente";
                var estadoIcon = "fa-circle";
                var entregablesActivos = unidad.Ind_Entregables?.Where(e => e.Activo).ToList();

                if (progreso != null)
                {
                    switch (progreso.Estado)
                    {
                        case "Asignado":
                            estadoClass = "info";
                            estadoTexto = "Asignado";
                            estadoIcon = "fa-tasks";
                            break;
                        case "Entregado":
                            estadoClass = "warning";
                            estadoTexto = "Entregado";
                            estadoIcon = "fa-check";
                            break;
                        case "Revisado":
                            estadoClass = "success";
                            estadoTexto = "Revisado";
                            estadoIcon = "fa-check-circle";
                            break;
                    }
                }

                var tieneDevuelto = TieneEntregableDevuelto(unidad, submisiones);
                if (tieneDevuelto)
                {
                    estadoClass = "danger";
                    estadoTexto = "Acción Requerida";
                    estadoIcon = "fa-exclamation-triangle";
                }

                <div class="card unidad-panel @(i == 0 ? "" : "d-none")" id="unidad-panel-@unidad.UnidadID">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="fas fa-list-ol"></i>
                            Unidad @unidad.Orden: @unidad.Nombre
                        </h6>
                        <span class="badge bg-@estadoClass">
                            <i class="fas @estadoIcon"></i> @estadoTexto
                        </span>
                    </div>
                    <div class="card-body">
                        @if (unidad.Ind_Materiales != null && unidad.Ind_Materiales.Any())
                        {
                            <h6 class="small text-muted text-uppercase mb-2">Materiales de Aprendizaje</h6>
                            <ul class="list-group list-group-flush mb-3">
                                @foreach (var material in unidad.Ind_Materiales)
                                {
                                    var iconClass = "";
                                    var badgeColor = "";

                                    switch (material.TipoRecurso?.ToLower())
                                    {
                                        case "pdf":
                                            iconClass = "fa-file-pdf";
                                            badgeColor = "bg-danger";
                                            break;
                                        case "video":
                                            iconClass = "fa-video";
                                            badgeColor = "bg-primary";
                                            break;
                                        case "enlace":
                                            iconClass = "fa-link";
                                            badgeColor = "bg-info";
                                            break;
                                        default:
                                            iconClass = "fa-file";
                                            badgeColor = "bg-secondary";
                                            break;
                                    }

                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <div>
                                            <i class="fas @iconClass text-muted me-1"></i>
                                            @material.Nombre
                                        </div>
                                        <div>
                                            <span class="badge @badgeColor me-2">@material.TipoRecurso</span>
                                            <a href="@material.RutaURL" target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-external-link-alt"></i> Abrir
                                            </a>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted small"><i class="fas fa-info-circle"></i> No hay materiales disponibles para esta unidad.</p>
                        }

                        @if (entregablesActivos != null && entregablesActivos.Any())
                        {
                            <h6 class="small text-muted text-uppercase mb-2 mt-3">Entregables</h6>
                            <ul class="list-group list-group-flush mb-3">
                                @foreach (var entregable in entregablesActivos)
                                {
                                    var submision = submisiones?.FirstOrDefault(s => s.EntregableID == entregable.EntregableID);
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <div>
                                            <i class="fas fa-file-alt text-muted me-1"></i>
                                            @entregable.Titulo
                                            @if (entregable.FechaLimite.HasValue)
                                            {
                                                <small class="text-muted"> (límite: @entregable.FechaLimite.Value.ToString("dd/MM/yyyy"))</small>
                                            }
                                        </div>
                                        <div>
                                            @if (submision == null)
                                            {
                                                <span class="badge bg-secondary me-2">Sin enviar</span>
                                            }
                                            else
                                            {
                                                var badgeClass = submision.Estado == "Revisado" ? "bg-success"
                                                    : submision.Estado == "Rechazado" ? "bg-danger" : "bg-warning";
                                                var submisionEstadoTexto = submision.Estado == "Rechazado" ? "Devuelto" : submision.Estado;
                                                <span class="badge @badgeClass me-2">
                                                    @submisionEstadoTexto
                                                </span>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modalSubirEntregable"
                                                    data-id="@entregable.EntregableID" data-titulo="@entregable.Titulo"
                                                    data-instrucciones="@entregable.Instrucciones"
                                                    data-fecha-limite="@(entregable.FechaLimite.HasValue ? entregable.FechaLimite.Value.ToString("dd/MM/yyyy") : "")"
                                                    data-submision-existe="@(submision != null ? "true" : "false")"
                                                    data-submision-fecha="@(submision?.FechaEnvio.ToString("dd/MM/yyyy HH:mm"))"
                                                    data-submision-estado="@(submision?.Estado == "Rechazado" ? "Devuelto" : submision?.Estado)"
                                                    data-submision-comentario="@(submision?.ComentarioRevisor)">
                                                <i class="fas fa-upload"></i> @(submision == null ? "Subir" : "Reemplazar")
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }

                        @if (progreso != null)
                        {
                            <hr />
                            <div class="small">
                                <p class="mb-1 text-muted">
                                    <strong class="text-body">Fecha de Asignación:</strong>
                                    @progreso.FechaAsignacion.ToString("dd/MM/yyyy")
                                </p>

                                @if (progreso.FechaEnvio.HasValue)
                                {
                                    <p class="mb-1 text-muted">
                                        <strong class="text-body">Fecha de Entrega:</strong> @progreso.FechaEnvio.Value.ToString("dd/MM/yyyy")
                                    </p>
                                }

                                @if (!string.IsNullOrEmpty(progreso.ComentariosEvaluador))
                                {
                                    <p class="mb-1 text-muted">
                                        <strong class="text-body">Comentarios del Evaluador:</strong>
                                        <br />
                                        <em>@progreso.ComentariosEvaluador</em>
                                    </p>
                                }

                                @if (progreso.Estado == "Revisado")
                                {
                                    <div class="alert alert-success mb-0 mt-2 py-2">
                                        <i class="fas fa-check-circle"></i>
                                        <strong>Unidad Completada y Revisada</strong>
                                    </div>
                                }
                                else if (tieneDevuelto)
                                {
                                    <div class="alert alert-danger mb-0 mt-2 py-2">
                                        <i class="fas fa-exclamation-triangle"></i>
                                        <span>
                                            <strong>Acción requerida:</strong> tu maestro devolvió uno o más entregables.
                                            Revisa los comentarios arriba y súbelos de nuevo con el botón "Reemplazar".
                                        </span>
                                    </div>
                                }
                                else if (progreso.Estado == "Asignado" && (entregablesActivos == null || !entregablesActivos.Any()))
                                {
                                    @* Solo para unidades sin entregables (de solo lectura, ej. de antes de que
                                       se exigiera al menos un entregable por unidad) — cuando sí hay entregables,
                                       la unidad pasa a "Entregado" sola en cuanto se suben todos, no hace falta
                                       declararlo a mano. *@
                                    <div class="mt-2">
                                        @using (Html.BeginForm("MarcarEntregado", "Aspirante", new { progresoId = progreso.ProgresoID, materiaId = Model.MateriaID }, FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-primary"
                                                    onclick="return confirm('¿Marcar esta unidad como entregada? Tu maestro la revisará.');">
                                                <i class="fas fa-check"></i> Marcar como Entregado
                                            </button>
                                        }
                                    </div>
                                }
                                else if (progreso.Estado == "Asignado")
                                {
                                    <p class="text-muted small mb-0">
                                        <i class="fas fa-info-circle"></i>
                                        Sube el/los entregable(s) de esta unidad para completarla.
                                    </p>
                                }
                                else if (progreso.Estado == "Entregado")
                                {
                                    <div class="alert alert-warning mb-0 mt-2 py-2">
                                        <i class="fas fa-hourglass-half"></i>
                                        En revisión por el maestro.
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="empty-state">
        <div class="icon-badge icon-badge-lg icon-badge-warning">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div class="empty-state-title">Sin unidades configuradas</div>
        <p class="mb-0">Esta materia no tiene unidades disponibles aún.</p>
    </div>
}

@* ===================== Modal: Curso Completado ===================== *@
<div class="modal fade" id="modalCursoCompletado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center">
            <div class="modal-header border-0">
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body pt-0 pb-4">
                <div class="icon-badge icon-badge-lg icon-badge-success mx-auto mb-3" style="width:72px; height:72px; font-size:2rem;">
                    <i class="fas fa-trophy"></i>
                </div>
                <h4 class="mb-2">¡Felicidades!</h4>
                <p class="mb-0">Has completado el curso de <strong>@ViewBag.MateriaNombre</strong>.</p>
                <p class="text-muted small mb-0">Sigue así.</p>
            </div>
            @using (Html.BeginForm("MarcarFelicitacionVista", "Aspirante", new { materiaId = Model.MateriaID }, FormMethod.Post, new { id = "formFelicitacionVista" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-footer border-0 flex-column pt-0">
                    <div class="form-check w-100 mb-2 text-start ps-4">
                        <input class="form-check-input" type="checkbox" name="noMostrarDeNuevo" value="true" id="noVolverMostrarFelicitacion" />
                        <label class="form-check-label small" for="noVolverMostrarFelicitacion">No volver a mostrar este mensaje</label>
                    </div>
                    <button type="submit" class="btn btn-success w-100" id="btnCerrarFelicitacion">Entendido</button>
                </div>
            }
        </div>
    </div>
</div>

@* ===================== Modal: Subir/Reemplazar Entregable ===================== *@
<div class="modal fade" id="modalSubirEntregable" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("UploadEntregable", "Aspirante", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="subirEntregableId" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fas fa-file-upload"></i> <span id="subirEntregableTitulo"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted" id="subirEntregableInstrucciones"></p>
                    <p class="small" id="subirEntregableFechaLimiteWrapper">
                        <strong>Fecha límite:</strong> <span id="subirEntregableFechaLimite"></span>
                    </p>
                    <div class="alert alert-info small" id="subirEntregableInfoExistente" style="display:none;">
                        <i class="fas fa-info-circle"></i>
                        <span>
                            Ya enviaste un archivo el <span id="subirEntregableFechaEnvio"></span>.
                            Estado actual: <strong id="subirEntregableEstado"></strong>
                            <br />
                            Subir un nuevo archivo reemplazará el anterior y reiniciará la revisión.
                        </span>
                    </div>
                    <div class="alert alert-light small" id="subirEntregableComentarioWrapper" style="display:none;">
                        <i class="fas fa-comment-dots"></i>
                        <span>
                            <strong>Comentarios del revisor:</strong>
                            <br />
                            <em id="subirEntregableComentario"></em>
                        </span>
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Archivo</label>
                        <input type="file" name="archivo" class="form-control" required />
                        <small class="form-text text-muted">
                            Formatos aceptados: PDF, DOCX, XLSX, JPG, PNG. Tamaño máximo: 10 MB.
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-upload"></i> Enviar Archivo</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        function selectUnidad(link, evt) {
            evt.preventDefault();

            document.querySelectorAll('.unidad-list-item').forEach(function (el) {
                el.classList.remove('active');
            });
            link.classList.add('active');

            document.querySelectorAll('.unidad-panel').forEach(function (el) {
                el.classList.add('d-none');
            });
            document.getElementById(link.getAttribute('data-target')).classList.remove('d-none');

            return false;
        }

        document.getElementById('modalSubirEntregable').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            document.getElementById('subirEntregableId').value = button.dataset.id;
            document.getElementById('subirEntregableTitulo').textContent = button.dataset.titulo || '';
            document.getElementById('subirEntregableInstrucciones').textContent = button.dataset.instrucciones || '';

            var fechaLimite = button.dataset.fechaLimite || '';
            document.getElementById('subirEntregableFechaLimiteWrapper').style.display = fechaLimite ? '' : 'none';
            document.getElementById('subirEntregableFechaLimite').textContent = fechaLimite;

            var existe = button.dataset.submisionExiste === 'true';
            document.getElementById('subirEntregableInfoExistente').style.display = existe ? '' : 'none';
            if (existe) {
                document.getElementById('subirEntregableFechaEnvio').textContent = button.dataset.submisionFecha || '';
                document.getElementById('subirEntregableEstado').textContent = button.dataset.submisionEstado || '';
            }

            var comentario = button.dataset.submisionComentario || '';
            document.getElementById('subirEntregableComentarioWrapper').style.display = comentario ? '' : 'none';
            document.getElementById('subirEntregableComentario').textContent = comentario;
        });

        document.getElementById('btnCerrarFelicitacion')?.addEventListener('click', function (e) {
            var checkbox = document.getElementById('noVolverMostrarFelicitacion');
            if (!checkbox.checked) {
                // No pidió "no volver a mostrar": solo cierra el modal, sin
                // avisar al servidor (así se vuelve a mostrar en la próxima visita).
                e.preventDefault();
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCursoCompletado')).hide();
            }
        });

        @if (materiaCompletada && !(bool)ViewBag.FelicitacionYaVista)
        {
            <text>
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCursoCompletado')).show();
            </text>
        }
    </script>
}

@section styles {
    <style>
        .unidad-list-card {
            position: sticky;
            top: 1rem;
        }

        .unidad-list-item {
            border-left: none;
            border-right: none;
            color: var(--gray-700);
            cursor: pointer;
        }

        .unidad-list-item:hover {
            background-color: var(--gray-50);
        }

        .unidad-list-item.active {
            background-color: var(--primary-light);
            color: var(--primary-dark);
            border-color: var(--gray-200);
            font-weight: var(--font-weight-semibold);
        }

        .list-group-item {
            border-left: none;
            border-right: none;
        }

        .list-group-item:first-child {
            border-top: none;
        }

        .progress-bar {
            background-color: var(--primary-color);
        }
    </style>
}
