@model induccion_refactorization.ViewModels.PagedResult<induccion_refactorization.Models.Ind_Materia>
@{
    ViewBag.Title = "Gestión de Contenido de Inducción";
    var puedeElegirTodas = (bool)ViewBag.PuedeElegirTodasLasCarreras;
    var carrerasList = (List<induccion_refactorization.Models.Carrera>)ViewBag.CarrerasList;
    bool puedeCrear = ViewBag.PuedeCrear;
    bool puedeEditar = ViewBag.PuedeEditar;
    bool puedeEliminar = ViewBag.PuedeEliminar;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="fas fa-book text-primary"></i> Gestión de Contenido de Inducción</h2>
        <p class="text-muted mb-0">Bienvenido, <strong>@ViewBag.NombreCompleto</strong></p>
    </div>
    @if (puedeCrear)
    {
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevaMateria">
            <i class="fas fa-plus"></i> Nueva Materia
        </button>
    }
</div>

<div class="row mb-4 g-3">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="icon-badge icon-badge-primary"><i class="fas fa-book-open"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.TotalMaterias</div>
                <div class="stat-card-label">Materias Activas</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="icon-badge icon-badge-info"><i class="fas fa-list"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.TotalUnidades</div>
                <div class="stat-card-label">Unidades Totales</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="icon-badge icon-badge-warning"><i class="fas fa-file-pdf"></i></div>
            <div>
                <div class="stat-card-value">@ViewBag.TotalMateriales</div>
                <div class="stat-card-label">Recursos Disponibles</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        @using (Html.BeginForm("Index", "InductionMaintenance", FormMethod.Get))
        {
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small text-muted mb-1">Buscar</label>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm"
                           placeholder="Nombre de la materia..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Carrera</label>
                    @Html.DropDownList("carreraId", (SelectList)ViewBag.CarrerasFiltro, "Todas", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Periodo</label>
                    @Html.DropDownList("periodoId", (SelectList)ViewBag.PeriodosFiltro, "Todos", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                        <i class="fas fa-search"></i> Filtrar
                    </button>
                    <a href="@Url.Action("Index", "InductionMaintenance")" class="btn btn-sm btn-outline-secondary btn-icon" title="Limpiar filtros">
                        <i class="fas fa-times"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Materias de Inducción</h5>
        <small class="text-muted">@Model.TotalCount resultado(s)</small>
    </div>
    <div class="card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-clean mb-0">
                    <thead>
                        <tr>
                            @{
                                var sortRouteValues = new System.Web.Routing.RouteValueDictionary(new
                                {
                                    search = ViewBag.Search,
                                    carreraId = ViewBag.CarreraId,
                                    periodoId = ViewBag.PeriodoId
                                });
                            }
                            <th>
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Nombre", SortField = "Nombre", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "Index", Controller = "InductionMaintenance", RouteValues = sortRouteValues
                                })
                            </th>
                            <th>
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Carrera", SortField = "Carrera", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "Index", Controller = "InductionMaintenance", RouteValues = sortRouteValues
                                })
                            </th>
                            <th>
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Periodo", SortField = "Periodo", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "Index", Controller = "InductionMaintenance", RouteValues = sortRouteValues
                                })
                            </th>
                            <th>
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Unidades", SortField = "Unidades", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "Index", Controller = "InductionMaintenance", RouteValues = sortRouteValues
                                })
                            </th>
                            <th>Descripción</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var materia in Model.Items)
                        {
                            <tr>
                                <td data-label="Nombre"><strong>@materia.Nombre</strong></td>
                                <td data-label="Carrera">
                                    @if (materia.TodasLasCarreras)
                                    {
                                        <span class="badge bg-info">Todas las carreras</span>
                                    }
                                    else
                                    {
                                        foreach (var carrera in materia.Carreras)
                                        {
                                            <span class="badge bg-info me-1" title="@carrera.Nombre">@(!string.IsNullOrEmpty(carrera.Nomenclatura) ? carrera.Nomenclatura : carrera.Nombre)</span>
                                        }
                                    }
                                </td>
                                <td data-label="Periodo"><span class="badge bg-secondary">@(materia.Periodo?.Nombre)</span></td>
                                <td data-label="Unidades"><span class="badge bg-primary">@materia.Ind_Unidades.Count</span></td>
                                <td data-label="Descripción">
                                    @if (!string.IsNullOrEmpty(materia.Descripcion))
                                    {
                                        <small>@(materia.Descripcion.Length > 80 ? materia.Descripcion.Substring(0, 80) + "..." : materia.Descripcion)</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Sin descripción</small>
                                    }
                                </td>
                                <td class="text-end" data-label="Acciones">
                                    <a href="@Url.Action("ManageUnidades", new { id = materia.MateriaID })"
                                       class="btn btn-sm btn-primary"
                                       title="Gestionar Unidades">
                                        <i class="fas fa-list"></i> Unidades
                                    </a>
                                    @if (puedeEditar)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-icon"
                                                title="Editar Materia"
                                                data-bs-toggle="modal" data-bs-target="#modalEditarMateria"
                                                data-id="@materia.MateriaID" data-nombre="@materia.Nombre"
                                                data-descripcion="@materia.Descripcion" data-periodo-id="@materia.PeriodoID"
                                                data-todas="@materia.TodasLasCarreras.ToString().ToLower()"
                                                data-carrera-ids="@string.Join(",", materia.Carreras.Select(c => c.CarreraID))">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    }
                                    @if (puedeEliminar)
                                    {
                                        using (Html.BeginForm("DeleteMateria", "InductionMaintenance", new { id = materia.MateriaID }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger btn-icon"
                                                    title="Desactivar Materia"
                                                    onclick="return confirm('¿Está seguro de desactivar esta materia?');">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @Html.Partial("_Pager", new induccion_refactorization.ViewModels.PagerViewModel
            {
                PageNumber = Model.PageNumber,
                TotalPages = Model.TotalPages,
                PageSize = Model.PageSize,
                Action = "Index",
                Controller = "InductionMaintenance",
                RouteValues = new System.Web.Routing.RouteValueDictionary(new { search = ViewBag.Search, carreraId = ViewBag.CarreraId, periodoId = ViewBag.PeriodoId, sortBy = ViewBag.SortBy, sortDir = ViewBag.SortDir })
            })
        }
        else
        {
            <div class="empty-state">
                <div class="icon-badge icon-badge-lg icon-badge-info">
                    <i class="fas fa-book"></i>
                </div>
                <div class="empty-state-title">No se encontraron materias</div>
                @if (puedeCrear)
                {
                    <p class="mb-0">
                        <button type="button" class="btn btn-link p-0 align-baseline" data-bs-toggle="modal" data-bs-target="#modalNuevaMateria">
                            Crear la primera materia
                        </button>
                    </p>
                }
            </div>
        }
    </div>
</div>

@* ===================== Modal: Nueva Materia ===================== *@
<div class="modal fade" id="modalNuevaMateria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("CreateMateria", "InductionMaintenance", FormMethod.Post, new { @class = "materia-form" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-plus-circle"></i> Nueva Materia</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="control-label">Nombre</label>
                        <input type="text" name="Nombre" class="form-control" placeholder="Ej: Introducción a la UTTN" required />
                        <small class="form-text text-muted">Nombre descriptivo de la materia de inducción</small>
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Descripción</label>
                        <textarea name="Descripcion" class="form-control" rows="4" placeholder="Describe los objetivos y contenido de esta materia..."></textarea>
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Carreras</label>
                        @if (puedeElegirTodas)
                        {
                            <div class="form-check mb-2">
                                <input type="checkbox" class="form-check-input" id="createTodasLasCarreras" name="todasLasCarreras" value="true" />
                                <label class="form-check-label" for="createTodasLasCarreras"><strong>Visible para todas las carreras</strong></label>
                            </div>
                        }
                        <input type="hidden" name="todasLasCarreras" value="false" />
                        <div id="createCarrerasListContainer" class="row g-2 ps-2">
                            @foreach (var carrera in carrerasList)
                            {
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input create-carrera-checkbox" name="carreraIds" value="@carrera.CarreraID" id="createCarrera_@carrera.CarreraID" />
                                        <label class="form-check-label" for="createCarrera_@carrera.CarreraID">@carrera.Nombre</label>
                                    </div>
                                </div>
                            }
                        </div>
                        <small class="form-text text-muted">
                            @if (puedeElegirTodas)
                            {
                                <text>Selecciona una o más carreras, o marca la casilla de arriba para hacerla visible a todas</text>
                            }
                            else
                            {
                                <text>Solo puedes asignarla a la(s) carrera(s) que tienes a cargo</text>
                            }
                        </small>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Periodo</label>
                        @Html.DropDownList("PeriodoID", (SelectList)ViewBag.PeriodosList, "-- Seleccione un periodo --", new { @class = "form-select" })
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Materia</button>
                </div>
            }
        </div>
    </div>
</div>

@* ===================== Modal: Editar Materia ===================== *@
<div class="modal fade" id="modalEditarMateria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("EditMateria", "InductionMaintenance", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="MateriaID" id="editMateriaId" />
                <input type="hidden" name="Activo" value="true" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-edit"></i> Editar Materia</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="control-label">Nombre</label>
                        <input type="text" name="Nombre" id="editMateriaNombre" class="form-control" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Descripción</label>
                        <textarea name="Descripcion" id="editMateriaDescripcion" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Carreras</label>
                        @if (puedeElegirTodas)
                        {
                            <div class="form-check mb-2">
                                <input type="checkbox" class="form-check-input" id="editTodasLasCarreras" name="todasLasCarreras" value="true" />
                                <label class="form-check-label" for="editTodasLasCarreras"><strong>Visible para todas las carreras</strong></label>
                            </div>
                        }
                        <input type="hidden" name="todasLasCarreras" value="false" />
                        <div id="editCarrerasListContainer" class="row g-2 ps-2">
                            @foreach (var carrera in carrerasList)
                            {
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input edit-carrera-checkbox" name="carreraIds" value="@carrera.CarreraID" id="editCarrera_@carrera.CarreraID" />
                                        <label class="form-check-label" for="editCarrera_@carrera.CarreraID">@carrera.Nombre</label>
                                    </div>
                                </div>
                            }
                        </div>
                        <small class="form-text text-muted">
                            @if (puedeElegirTodas)
                            {
                                <text>Selecciona una o más carreras, o marca la casilla de arriba para hacerla visible a todas</text>
                            }
                            else
                            {
                                <text>Solo puedes asignarla a la(s) carrera(s) que tienes a cargo</text>
                            }
                        </small>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Periodo</label>
                        @Html.DropDownList("PeriodoID", (SelectList)ViewBag.PeriodosList, new { @class = "form-select", id = "editMateriaPeriodo" })
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Cambios</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);

            function toggleCarrerasList(checkboxSelector, listSelector, containerSelector) {
                var todas = $(checkboxSelector).is(':checked');
                $(listSelector).prop('disabled', todas);
                $(containerSelector).css('opacity', todas ? 0.5 : 1);
            }

            $('#createTodasLasCarreras').on('change', function () {
                toggleCarrerasList('#createTodasLasCarreras', '.create-carrera-checkbox', '#createCarrerasListContainer');
            });
            toggleCarrerasList('#createTodasLasCarreras', '.create-carrera-checkbox', '#createCarrerasListContainer');

            $('#editTodasLasCarreras').on('change', function () {
                toggleCarrerasList('#editTodasLasCarreras', '.edit-carrera-checkbox', '#editCarrerasListContainer');
            });

            document.getElementById('modalEditarMateria').addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('editMateriaId').value = button.dataset.id;
                document.getElementById('editMateriaNombre').value = button.dataset.nombre;
                document.getElementById('editMateriaDescripcion').value = button.dataset.descripcion;
                document.getElementById('editMateriaPeriodo').value = button.dataset.periodoId;

                var todas = button.dataset.todas === 'true';
                $('#editTodasLasCarreras').prop('checked', todas);

                var selectedIds = (button.dataset.carreraIds || '').split(',').filter(function (v) { return v !== ''; });
                $('.edit-carrera-checkbox').each(function () {
                    $(this).prop('checked', selectedIds.indexOf(this.value) !== -1);
                });

                toggleCarrerasList('#editTodasLasCarreras', '.edit-carrera-checkbox', '#editCarrerasListContainer');
            });

            $('.materia-form').on('submit', function() {
                var $btn = $(this).find('button[type="submit"]');
                $btn.prop('disabled', true);
                $btn.html('<i class="fas fa-spinner fa-spin"></i> Guardando...');
            });
        });
    </script>
}
