                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Cambios</button>
                </div>
            }
        </div>
    </div>
</div>

@* ===================== Modal: Editar Entregable ===================== *@
<div class="modal fade" id="modalEditarEntregable" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("EditEntregable", "InductionMaintenance", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="entregableId" id="editEntregableId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-pen"></i> Editar Entregable</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="control-label">Título</label>
                        <input type="text" name="titulo" id="editEntregableTitulo" class="form-control" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Instrucciones</label>
                        <textarea name="instrucciones" id="editEntregableInstrucciones" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="control-label">Fecha Límite</label>
                            <input type="date" name="fechaLimite" id="editEntregableFecha" class="form-control" />
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="control-label">Ponderación Máxima</label>
                            <input type="number" name="ponderacionMax" id="editEntregablePonderacion" class="form-control" step="0.01" min="0" max="100" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Cambios</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.js"
            integrity="sha512-TelkP3PCMJv+viMWynjKcvLsQzx6dJHvIGhfqzFtZKgAjKM1YPqcwzzDEoTc/BHjf43PcPzTQOjuTr4YdE8lNQ=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        $(document).ready(function () {
            var token = $('input[name="__RequestVerificationToken"]').first().val();

            function escapeHtml(str) {
                return $('<div>').text(str || '').html();
            }

            // ---------- Drag and drop reordering ----------
            // Todo este bloque depende de SortableJS (CDN externo). Si la librería no
            // cargó (red bloqueada, CDN caído, etc.) se omite el reordenamiento por
            // arrastre, pero el resto de la página (modales de Agregar/Editar/Asignar)
            // debe seguir funcionando con normalidad.
            if (typeof Sortable !== 'undefined') {
                var unidadesContainer = document.getElementById('accordionUnidades');
                if (unidadesContainer && unidadesContainer.children.length > 1) {
                    new Sortable(unidadesContainer, {
                        handle: '.drag-handle-unidad',
                        animation: 150,
                        onEnd: function () {
                            var ids = Array.from(unidadesContainer.children).map(function (el) { return el.dataset.unidadId; });
                            $.ajax({
                                url: '@Url.Action("ReordenarUnidades", "InductionMaintenance")',
                                type: 'POST',
                                traditional: true,
                                data: { materiaId: @materiaId, orderedIds: ids, __RequestVerificationToken: token }
                            });
                        }
                    });
                }

                document.querySelectorAll('.sortable-materiales').forEach(function (el) {
                    if (el.children.length > 1) {
                        new Sortable(el, {
                            handle: '.drag-handle-material',
                            animation: 150,
                            onEnd: function () {
                                var ids = Array.from(el.children).map(function (li) { return li.dataset.id; });
                                $.ajax({
                                    url: '@Url.Action("ReordenarMateriales", "InductionMaintenance")',
                                    type: 'POST',
                                    traditional: true,
                                    data: { unidadId: el.dataset.unidadId, orderedIds: ids, __RequestVerificationToken: token }
                                });
                            }
                        });
                    }
                });

                document.querySelectorAll('.sortable-entregables').forEach(function (el) {
                    if (el.children.length > 1) {
                        new Sortable(el, {
                            handle: '.drag-handle-entregable',
                            animation: 150,
                            onEnd: function () {
                                var ids = Array.from(el.children).map(function (li) { return li.dataset.id; });
                                $.ajax({
                                    url: '@Url.Action("ReordenarEntregables", "InductionMaintenance")',
                                    type: 'POST',
                                    traditional: true,
                                    data: { unidadId: el.dataset.unidadId, orderedIds: ids, __RequestVerificationToken: token }
                                });
                            }
                        });
                    }
                });
            } else if (window.console) {
                console.warn('SortableJS no se cargó; el reordenamiento por arrastre está deshabilitado en esta página.');
            }

            // ---------- Preselect unidad when opening Agregar Material/Entregable from an empty unit ----------
            document.getElementById('modalAgregarMaterial').addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var pre = button && button.dataset ? button.dataset.preselectUnidad : null;
                if (pre) {
                    document.getElementById('agregarMaterialUnidadSelect').value = pre;
                }
            });

            document.getElementById('modalAgregarEntregable').addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var pre = button && button.dataset ? button.dataset.preselectUnidad : null;
                if (pre) {
                    document.getElementById('agregarEntregableUnidadSelect').value = pre;
                }
            });

            // ---------- Editar Unidad ----------
            document.getElementById('modalEditarUnidad').addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('editUnidadId').value = button.dataset.id;
                document.getElementById('editUnidadNombre').value = button.dataset.nombre;
            });

            // ---------- Editar Material ----------
            document.getElementById('modalEditarMaterial').addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('editMaterialId').value = button.dataset.id;
                document.getElementById('editMaterialNombre').value = button.dataset.nombre;
                document.getElementById('editMaterialTipo').value = button.dataset.tipo;
                document.getElementById('editMaterialUrl').value = button.dataset.url;
            });

            // ---------- Editar Entregable ----------
            document.getElementById('modalEditarEntregable').addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('editEntregableId').value = button.dataset.id;
                document.getElementById('editEntregableTitulo').value = button.dataset.titulo;
                document.getElementById('editEntregableInstrucciones').value = button.dataset.instrucciones;
                document.getElementById('editEntregableFecha').value = button.dataset.fecha;
                document.getElementById('editEntregablePonderacion').value = button.dataset.ponderacion;
            });

            // ---------- Asignar Unidad ----------
            var selectUnidadAsignar = document.getElementById('asignarUnidadSelect');
            var aspirantesContainer = document.getElementById('asignarAspirantesContainer');

            function toggleModo() {
                var manual = $('#modoManual').is(':checked');
                $('#listaManualContainer').toggle(manual);
            }
            $('input[name="modo"]').on('change', toggleModo);
            toggleModo();

            function cargarAspirantes(unidadId) {
                if (!aspirantesContainer) { return; }
                if (!unidadId) {
                    aspirantesContainer.innerHTML = '<p class="text-muted small mb-0">Selecciona una unidad para ver los aspirantes.</p>';
                    return;
                }
                aspirantesContainer.innerHTML = '<p class="text-muted small mb-0"><i class="fas fa-spinner fa-spin"></i> Cargando...</p>';
                $.getJSON('@Url.Action("AsignarUnidadAspirantes", "Coordinador")', { unidadId: unidadId }, function (resp) {
                    if (!resp.success) {
                        aspirantesContainer.innerHTML = '<p class="text-danger small mb-0">' + escapeHtml(resp.message || 'Error al cargar aspirantes.') + '</p>';
                        return;
                    }
                    if (!resp.aspirantes.length) {
                        aspirantesContainer.innerHTML = '<p class="text-muted small mb-0">No hay aspirantes en tu carrera todavía.</p>';
                        return;
                    }
                    var html = '<div class="row g-2" id="aspirantesListContainer" style="max-height:320px; overflow-y:auto;">';
                    resp.aspirantes.forEach(function (a) {
                        html += '<div class="col-md-6 aspirante-item" data-nombre="' + escapeHtml((a.nombre || '').toLowerCase()) + '" data-matricula="' + escapeHtml((a.matricula || '').toLowerCase()) + '">' +
                            '<div class="form-check d-flex align-items-center gap-2">' +
                            '<input type="checkbox" class="form-check-input aspirante-checkbox" name="aspiranteIds" value="' + a.id + '" id="asp_' + a.id + '" />' +
                            '<label class="form-check-label flex-grow-1" for="asp_' + a.id + '">' + escapeHtml(a.nombre) +
                            '<small class="text-muted d-block">Matrícula: ' + escapeHtml(a.matricula || 'N/A') + '</small></label>' +
                            (a.yaAsignado ? '<span class="badge bg-secondary">Ya asignado</span>' : '') +
                            '</div></div>';
                    });
                    html += '</div>';
                    aspirantesContainer.innerHTML = html;
                });
            }

            if (selectUnidadAsignar) {
                selectUnidadAsignar.addEventListener('change', function () {
                    cargarAspirantes(this.value);
                });
            }

            $(document).on('input', '#filtroAspirantes', function () {
                var term = $(this).val().toLowerCase();
                $('.aspirante-item').each(function () {
                    var nombre = $(this).data('nombre') || '';
                    var matricula = $(this).data('matricula') || '';
                    var visible = String(nombre).indexOf(term) !== -1 || String(matricula).indexOf(term) !== -1;
                    $(this).toggle(visible);
                });
            });

            $('.asignar-form').on('submit', function (e) {
                var manual = $('#modoManual').is(':checked');
                if (manual && $('.aspirante-checkbox:checked').length === 0) {
                    e.preventDefault();
                    alert('Selecciona al menos un aspirante, o cambia a "Todos mis aspirantes".');
                    return false;
                }
                var $btn = $(this).find('button[type="submit"]');
                $btn.prop('disabled', true);
                $btn.html('<i class="fas fa-spinner fa-spin"></i> Asignando...');
            });
        });
    </script>
}
