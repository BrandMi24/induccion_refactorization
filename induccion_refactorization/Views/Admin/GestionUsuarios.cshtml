@model induccion_refactorization.ViewModels.PagedResult<induccion_refactorization.Models.Usuario>
@{
    ViewBag.Title = "Gestión de Usuarios";
    var rolesConCarrera = (int[])ViewBag.RolesConCarrera;
    var carrerasListUsuario = (List<induccion_refactorization.Models.Carrera>)ViewBag.CarrerasList;
    var usuarioIdActual = ViewBag.UsuarioIDActual != null ? (int)ViewBag.UsuarioIDActual : 0;
    bool puedeCrear = ViewBag.PuedeCrear;
    bool puedeEditar = ViewBag.PuedeEditar;
    bool puedeEliminar = ViewBag.PuedeEliminar;
    bool puedeVerRoles = ViewBag.PuedeVerRoles;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="fas fa-user-cog text-primary"></i> Gestión de Usuarios</h2>
        <p class="text-muted mb-0">Bienvenido, <strong>@ViewBag.NombreCompleto</strong></p>
    </div>
    <div class="d-flex gap-2">
        @if (puedeVerRoles)
        {
            <a href="@Url.Action("Permisos", "Admin")" class="btn btn-outline-secondary">
                <i class="fas fa-shield-alt"></i> Permisos por Rol
            </a>
        }
        @if (puedeCrear)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoUsuario">
                <i class="fas fa-user-plus"></i> Nuevo Usuario
            </button>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        @using (Html.BeginForm("GestionUsuarios", "Admin", FormMethod.Get))
        {
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small text-muted mb-1">Buscar</label>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm"
                           placeholder="Nombre, usuario o correo..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Rol</label>
                    @Html.DropDownList("rolId", (SelectList)ViewBag.RolesFiltro, "Todos los roles", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Estado</label>
                    @{
                        var activoFiltro = ViewBag.Activo as bool?;
                    }
                    <select name="activo" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        @if (activoFiltro == true)
                        {
                            <option value="true" selected="selected">Activo</option>
                        }
                        else
                        {
                            <option value="true">Activo</option>
                        }
                        @if (activoFiltro == false)
                        {
                            <option value="false" selected="selected">Inactivo</option>
                        }
                        else
                        {
                            <option value="false">Inactivo</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                        <i class="fas fa-search"></i> Filtrar
                    </button>
                    <a href="@Url.Action("GestionUsuarios", "Admin")" class="btn btn-sm btn-outline-secondary btn-icon" title="Limpiar filtros">
                        <i class="fas fa-times"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Usuarios del Sistema</h5>
        <small class="text-muted">@Model.TotalCount resultado(s)</small>
    </div>
    <div class="card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-clean mb-0">
                    <thead>
                        <tr>
                            @{
                                var sortRouteValues = new System.Web.Routing.RouteValueDictionary(new
                                {
                                    search = ViewBag.Search,
                                    rolId = ViewBag.RolId,
                                    activo = ViewBag.Activo
                                });
                            }
                            <th>
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Usuario", SortField = "Nombre", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "GestionUsuarios", Controller = "Admin", RouteValues = sortRouteValues
                                })
                            </th>
                            <th>
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Correo", SortField = "Correo", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "GestionUsuarios", Controller = "Admin", RouteValues = sortRouteValues
                                })
                            </th>
                            <th>
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Rol", SortField = "Rol", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "GestionUsuarios", Controller = "Admin", RouteValues = sortRouteValues
                                })
                            </th>
                            <th class="text-center">
                                @Html.Partial("_SortableHeader", new induccion_refactorization.ViewModels.SortableHeaderViewModel
                                {
                                    Label = "Estado", SortField = "Estado", CurrentSortBy = ViewBag.SortBy, CurrentSortDir = ViewBag.SortDir,
                                    Action = "GestionUsuarios", Controller = "Admin", RouteValues = sortRouteValues
                                })
                            </th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model.Items)
                        {
                            <tr>
                                <td data-label="Usuario">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="icon-badge icon-badge-sm icon-badge-primary">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@usuario.NombreCompleto</div>
                                            <small class="text-muted">@usuario.NombreUsuario</small>
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Correo">@usuario.CorreoElectronico</td>
                                <td data-label="Rol">
                                    <span class="badge bg-info">@(usuario.Role?.Nombre)</span>
                                </td>
                                <td class="text-center" data-label="Estado">
                                    @if (usuario.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end" data-label="Acciones">
                                    @if (puedeEditar)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-icon"
                                                title="Editar Usuario"
                                                data-bs-toggle="modal" data-bs-target="#modalEditarUsuario"
                                                data-id="@usuario.UsuarioID" data-nombre="@usuario.Nombre"
                                                data-apellido-paterno="@usuario.ApellidoPaterno" data-apellido-materno="@usuario.ApellidoMaterno"
                                                data-nombre-usuario="@usuario.NombreUsuario" data-correo="@usuario.CorreoElectronico"
                                                data-rol-id="@usuario.RolID"
                                                data-carrera-ids="@string.Join(",", usuario.Carreras.Select(c => c.CarreraID))"
                                                data-nombre-completo="@usuario.NombreCompleto"
                                                data-es-propia-cuenta="@(usuario.UsuarioID == usuarioIdActual ? "true" : "false")">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    }
                                    @if (puedeEliminar)
                                    {
                                        using (Html.BeginForm("ToggleActivoUsuario", "Admin", new { id = usuario.UsuarioID }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-icon @(usuario.Activo ? "btn-outline-danger" : "btn-outline-success")"
                                                    title="@(usuario.Activo ? "Desactivar" : "Reactivar")"
                                                    onclick="return confirm('¿Está seguro de @(usuario.Activo ? "desactivar" : "reactivar") este usuario?');">
                                                <i class="fas @(usuario.Activo ? "fa-user-slash" : "fa-user-check")"></i>
                                            </button>
                                        }
                                    }
                                    @if (puedeEliminar && usuario.UsuarioID != usuarioIdActual)
                                    {
                                        using (Html.BeginForm("DeleteUsuario", "Admin", new { id = usuario.UsuarioID }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-icon btn-outline-danger"
                                                    title="Eliminar permanentemente"
                                                    onclick="return confirm('¿Está seguro de ELIMINAR PERMANENTEMENTE a @usuario.NombreCompleto? Esta acción no se puede deshacer. Si tiene historial asociado (documentos, calificaciones, etc.), no se podrá eliminar.');">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @Html.Partial("_Pager", new induccion_refactorization.ViewModels.PagerViewModel
            {
                PageNumber = Model.PageNumber,
                TotalPages = Model.TotalPages,
                PageSize = Model.PageSize,
                Action = "GestionUsuarios",
                Controller = "Admin",
                RouteValues = new System.Web.Routing.RouteValueDictionary(new { search = ViewBag.Search, rolId = ViewBag.RolId, activo = ViewBag.Activo, sortBy = ViewBag.SortBy, sortDir = ViewBag.SortDir })
            })
        }
        else
        {
            <div class="empty-state">
                <div class="icon-badge icon-badge-lg icon-badge-info">
                    <i class="fas fa-users"></i>
                </div>
                <div class="empty-state-title">No se encontraron usuarios</div>
                <p class="mb-0">Intenta ajustar los filtros de búsqueda.</p>
            </div>
        }
    </div>
</div>

@* ===================== Modal: Nuevo Usuario ===================== *@
<div class="modal fade" id="modalNuevoUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("CreateUsuario", "Admin", FormMethod.Post, new { @class = "usuario-form" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-user-plus"></i> Nuevo Usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="control-label">Nombre</label>
                            <input type="text" name="Nombre" class="form-control" required />
                        </div>
                        <div class="col-md-3 form-group mb-3">
                            <label class="control-label">Apellido Paterno</label>
                            <input type="text" name="ApellidoPaterno" class="form-control" required />
                        </div>
                        <div class="col-md-3 form-group mb-3">
                            <label class="control-label">Apellido Materno</label>
                            <input type="text" name="ApellidoMaterno" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Nombre de Usuario</label>
                        <input type="text" name="NombreUsuario" class="form-control" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Correo Electrónico</label>
                        <input type="email" name="CorreoElectronico" class="form-control" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Contraseña</label>
                        <input type="password" name="Contrasena" class="form-control" required minlength="8" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Rol</label>
                        @Html.DropDownList("RolID", (SelectList)ViewBag.RolesList, "-- Seleccione un rol --", new { @class = "form-select", id = "createRolID" })
                    </div>
                    <div class="form-group" id="createCarrerasSection">
                        <label class="control-label">Carrera(s) a cargo</label>
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" id="createTodasLasCarrerasUsuario" />
                            <label class="form-check-label" for="createTodasLasCarrerasUsuario"><strong>Seleccionar todas las carreras</strong></label>
                        </div>
                        <div class="row g-2 ps-2">
                            @foreach (var carrera in carrerasListUsuario)
                            {
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input create-usuario-carrera-checkbox" name="carreraIds" value="@carrera.CarreraID" id="createUsuarioCarrera_@carrera.CarreraID" />
                                        <label class="form-check-label" for="createUsuarioCarrera_@carrera.CarreraID">@carrera.Nombre</label>
                                    </div>
                                </div>
                            }
                        </div>
                        <small class="form-text text-muted">Solo aplica para Coordinador, Maestro y Aspirante. Se puede seleccionar una, varias, o todas.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Usuario</button>
                </div>
            }
        </div>
    </div>
</div>

@* ===================== Modal: Editar Usuario ===================== *@
<div class="modal fade" id="modalEditarUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            @using (Html.BeginForm("EditUsuario", "Admin", FormMethod.Post, new { @class = "usuario-form" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="UsuarioID" id="editUsuarioId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-user-edit"></i> Editar Usuario — <span id="editUsuarioNombreCompleto"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="editUsuarioTabDatosBtn" data-bs-toggle="tab" data-bs-target="#editUsuarioTabDatos" type="button" role="tab">
                                <i class="fas fa-id-card"></i> Datos Generales
                            </button>
                        </li>
                        <li class="nav-item" role="presentation" id="editUsuarioTabPermisosItem">
                            <button class="nav-link" id="editUsuarioTabPermisosBtn" data-bs-toggle="tab" data-bs-target="#editUsuarioTabPermisos" type="button" role="tab">
                                <i class="fas fa-user-lock"></i> Permisos Individuales
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="editUsuarioTabDatos" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6 form-group mb-3">
                                    <label class="control-label">Nombre</label>
                                    <input type="text" name="Nombre" id="editUsuarioNombre" class="form-control" required />
                                </div>
                                <div class="col-md-3 form-group mb-3">
                                    <label class="control-label">Apellido Paterno</label>
                                    <input type="text" name="ApellidoPaterno" id="editUsuarioApellidoPaterno" class="form-control" required />
                                </div>
                                <div class="col-md-3 form-group mb-3">
                                    <label class="control-label">Apellido Materno</label>
                                    <input type="text" name="ApellidoMaterno" id="editUsuarioApellidoMaterno" class="form-control" />
                                </div>
                            </div>
                            <div class="form-group mb-3">
                                <label class="control-label">Nombre de Usuario</label>
                                <input type="text" name="NombreUsuario" id="editUsuarioNombreUsuario" class="form-control" required />
                            </div>
                            <div class="form-group mb-3">
                                <label class="control-label">Correo Electrónico</label>
                                <input type="email" name="CorreoElectronico" id="editUsuarioCorreo" class="form-control" required />
                            </div>
                            <div class="form-group mb-3">
                                <label class="control-label">Nueva Contraseña</label>
                                <input type="password" name="Contrasena" class="form-control" placeholder="Dejar en blanco para no cambiar" />
                                <small class="form-text text-muted">Solo complete este campo si desea cambiar la contraseña.</small>
                            </div>
                            <div class="form-group mb-3">
                                <label class="control-label">Rol</label>
                                @Html.DropDownList("RolID", (SelectList)ViewBag.RolesList, new { @class = "form-select", id = "editRolID" })
                            </div>
                            <div class="form-group" id="editCarrerasSection">
                                <label class="control-label">Carrera(s) a cargo</label>
                                <div class="form-check mb-2">
                                    <input type="checkbox" class="form-check-input" id="editTodasLasCarrerasUsuario" />
                                    <label class="form-check-label" for="editTodasLasCarrerasUsuario"><strong>Seleccionar todas las carreras</strong></label>
                                </div>
                                <div class="row g-2 ps-2">
                                    @foreach (var carrera in carrerasListUsuario)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input edit-usuario-carrera-checkbox" name="carreraIds" value="@carrera.CarreraID" id="editUsuarioCarrera_@carrera.CarreraID" />
                                                <label class="form-check-label" for="editUsuarioCarrera_@carrera.CarreraID">@carrera.Nombre</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <small class="form-text text-muted">Solo aplica para Coordinador, Maestro y Aspirante. Se puede seleccionar una, varias, o todas las carreras a cargo.</small>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="editUsuarioTabPermisos" role="tabpanel">
                            <p class="small text-muted">
                                Cada casilla ya viene marcada según lo que su rol permite hoy. Si la cambias, esa
                                sección queda resaltada como una excepción solo para este usuario (por ejemplo, es
                                Coordinador pero no quieres que él en particular tenga tal permiso) — usa "Quitar
                                excepciones" al final de la fila para que esa sección vuelva a seguir automáticamente
                                lo que diga su rol.
                            </p>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0 permisos-usuario-table">
                                    <thead>
                                        <tr>
                                            <th style="min-width: 160px;">Sección</th>
                                            <th class="text-center" style="min-width: 80px;">Leer</th>
                                            <th class="text-center" style="min-width: 80px;">Crear</th>
                                            <th class="text-center" style="min-width: 80px;">Editar</th>
                                            <th class="text-center" style="min-width: 80px;">Eliminar</th>
                                            <th class="text-center" style="min-width: 170px;">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody id="editUsuarioPermisosBody">
                                    </tbody>
                                </table>
                            </div>
                            <div id="editUsuarioPermisosSinSecciones" class="small text-muted" style="display: none;">
                                Todavía no hay secciones en el catálogo de permisos.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Cambios</button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .permisos-usuario-table td.tiene-excepcion {
        background-color: rgba(255, 193, 7, 0.15);
    }

    .permisos-usuario-table .permiso-checkbox {
        float: none;
        margin: 0;
        display: inline-block;
        vertical-align: middle;
    }
</style>

@section scripts {
    <script>
        $(document).ready(function() {
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);

            var rolesConCarrera = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.RolesConCarrera));

            var permisosCatalogo = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.PermisosCatalogo));
            var rolPermisosTodos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.RolPermisosTodos));
            var usuarioPermisosOverrides = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.UsuarioPermisosOverrides));

            // Construye una celda con: un checkbox (el valor efectivo: la excepción
            // del usuario si existe, si no lo que ya tiene el rol por defecto) y un
            // input oculto que es lo que realmente se manda al servidor ('' = hereda
            // del rol, 'true'/'false' = excepción explícita de este usuario). El
            // valor por defecto del rol queda en data-rol-default para que el botón
            // "Quitar excepciones" de la fila sepa a qué volver.
            function construirCeldaPermiso($td, nombreCampo, valorRolPorDefecto, valorExcepcion) {
                var tieneExcepcion = valorExcepcion !== null && valorExcepcion !== undefined;
                var valorEfectivo = tieneExcepcion ? valorExcepcion : valorRolPorDefecto;

                var $hidden = $('<input type="hidden">')
                    .attr('name', nombreCampo)
                    .val(tieneExcepcion ? String(valorExcepcion) : '');
                var $checkbox = $('<input type="checkbox" class="form-check-input permiso-checkbox">')
                    .prop('checked', valorEfectivo)
                    .attr('data-rol-default', valorRolPorDefecto ? 'true' : 'false');

                $td.toggleClass('tiene-excepcion', tieneExcepcion);

                $checkbox.on('change', function () {
                    $hidden.val(String($checkbox.prop('checked')));
                    $td.toggleClass('tiene-excepcion', true);
                    actualizarBotonQuitarExcepciones($td.closest('tr'));
                });

                $td.append($hidden, $checkbox);
            }

            // Habilita/deshabilita el botón "Quitar excepciones" de una fila según si
            // esa sección tiene o no alguna excepción marcada en este momento.
            function actualizarBotonQuitarExcepciones($tr) {
                var hayExcepcion = $tr.find('td.tiene-excepcion').length > 0;
                $tr.find('.permiso-quitar-fila').prop('disabled', !hayExcepcion);
            }

            // Muestra TODAS las secciones del catálogo (igual que Permisos por Rol),
            // no solo las que ya tengan una fila guardada para este rol — así se ve
            // completo aunque el rol nunca se haya tocado desde Permisos por Rol.
            // El valor por defecto de cada acción se toma de lo que ya tiene
            // predefinido el rol (se muestra en la propia etiqueta "Heredar del
            // rol"); desde aquí se puede seguir editando por excepción, por usuario.
            function construirPermisosUsuario(usuarioId, rolId) {
                var $body = $('#editUsuarioPermisosBody');
                $body.empty();

                var overridesDelUsuario = usuarioPermisosOverrides.filter(function (up) { return up.UsuarioID === usuarioId; });

                $('#editUsuarioPermisosSinSecciones').toggle(permisosCatalogo.length === 0);

                var idx = 0;
                permisosCatalogo.forEach(function (permiso) {
                    var permisoRol = rolPermisosTodos.filter(function (rp) { return rp.RolID === rolId && rp.PermisoID === permiso.PermisoID; })[0];
                    var overrideActual = overridesDelUsuario.filter(function (up) { return up.PermisoID === permiso.PermisoID; })[0];

                    var $tr = $('<tr></tr>');
                    $tr.append($('<td></td>').text(permiso.Nombre));
                    $tr.append($('<input type="hidden">').attr('name', 'permisos[' + idx + '].PermisoID').val(permiso.PermisoID));

                    ['Leer', 'Crear', 'Editar', 'Eliminar'].forEach(function (accion) {
                        var $td = $('<td class="text-center"></td>');
                        var valorExcepcion = overrideActual ? overrideActual['Puede' + accion] : null;
                        var valorRolPorDefecto = permisoRol ? permisoRol['Puede' + accion] : false;
                        construirCeldaPermiso($td, 'permisos[' + idx + '].' + accion, valorRolPorDefecto, valorExcepcion);
                        $tr.append($td);
                    });

                    var $tdAcciones = $('<td class="text-center"></td>');
                    var $btnQuitarFila = $('<button type="button" class="btn btn-sm btn-outline-danger btn-icon permiso-quitar-fila" title="Quitar excepciones"><i class="fas fa-undo"></i></button>');
                    $btnQuitarFila.on('click', function () {
                        $tr.find('.permiso-checkbox').each(function () {
                            var $cb = $(this);
                            var rolDefault = $cb.attr('data-rol-default') === 'true';
                            $cb.siblings('input[type=hidden]').val('');
                            $cb.prop('checked', rolDefault);
                        });
                        $tr.find('td').removeClass('tiene-excepcion');
                        actualizarBotonQuitarExcepciones($tr);
                    });
                    $tdAcciones.append($btnQuitarFila);
                    $tr.append($tdAcciones);

                    $body.append($tr);
                    actualizarBotonQuitarExcepciones($tr);
                    idx++;
                });
            }

            function toggleCarrerasSection(selectSelector, sectionSelector) {
                var rolId = parseInt($(selectSelector).val(), 10);
                var mostrar = rolesConCarrera.indexOf(rolId) !== -1;
                $(sectionSelector).toggle(mostrar);
            }

            $('#createRolID').on('change', function () { toggleCarrerasSection('#createRolID', '#createCarrerasSection'); });
            toggleCarrerasSection('#createRolID', '#createCarrerasSection');

            $('#editRolID').on('change', function () { toggleCarrerasSection('#editRolID', '#editCarrerasSection'); });

            // "Seleccionar todas las carreras": marca/desmarca todas las carreras
            // individuales de un jalón; si el usuario las va marcando una por una
            // hasta completarlas todas, el checkbox maestro también se marca solo.
            function setupSeleccionarTodasCarreras(masterId, itemsSelector) {
                var $master = $('#' + masterId);
                var $items = $(itemsSelector);

                $master.on('change', function () {
                    $items.prop('checked', $master.prop('checked'));
                });

                $items.on('change', function () {
                    var todasMarcadas = $items.length > 0 && $items.filter(':checked').length === $items.length;
                    $master.prop('checked', todasMarcadas);
                });
            }

            function sincronizarMasterCarreras(masterId, itemsSelector) {
                var $items = $(itemsSelector);
                var todasMarcadas = $items.length > 0 && $items.filter(':checked').length === $items.length;
                $('#' + masterId).prop('checked', todasMarcadas);
            }

            setupSeleccionarTodasCarreras('createTodasLasCarrerasUsuario', '.create-usuario-carrera-checkbox');
            setupSeleccionarTodasCarreras('editTodasLasCarrerasUsuario', '.edit-usuario-carrera-checkbox');

            document.getElementById('modalEditarUsuario').addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var usuarioId = parseInt(button.dataset.id, 10);
                var rolId = parseInt(button.dataset.rolId, 10);
                var esPropiaCuenta = button.dataset.esPropiaCuenta === 'true';

                document.getElementById('editUsuarioId').value = usuarioId;
                document.getElementById('editUsuarioNombre').value = button.dataset.nombre;
                document.getElementById('editUsuarioApellidoPaterno').value = button.dataset.apellidoPaterno;
                document.getElementById('editUsuarioApellidoMaterno').value = button.dataset.apellidoMaterno;
                document.getElementById('editUsuarioNombreUsuario').value = button.dataset.nombreUsuario;
                document.getElementById('editUsuarioCorreo').value = button.dataset.correo;
                document.getElementById('editUsuarioNombreCompleto').textContent = button.dataset.nombreCompleto || '';
                $('#editRolID').val(button.dataset.rolId);

                var selectedIds = (button.dataset.carreraIds || '').split(',').filter(function (v) { return v !== ''; });
                $('.edit-usuario-carrera-checkbox').each(function () {
                    $(this).prop('checked', selectedIds.indexOf(this.value) !== -1);
                });
                sincronizarMasterCarreras('editTodasLasCarrerasUsuario', '.edit-usuario-carrera-checkbox');

                toggleCarrerasSection('#editRolID', '#editCarrerasSection');

                // Un Admin no puede editarse sus propios permisos individuales
                // (para no bloquearse a sí mismo por accidente), así que esa
                // pestaña se oculta cuando el usuario editado es su propia cuenta.
                $('#editUsuarioTabPermisosItem').toggle(!esPropiaCuenta);
                if (!esPropiaCuenta) {
                    construirPermisosUsuario(usuarioId, rolId);
                }

                // Siempre abrir en la pestaña de Datos Generales, sin importar en
                // cuál se haya quedado la última vez que se abrió este modal.
                bootstrap.Tab.getOrCreateInstance(document.getElementById('editUsuarioTabDatosBtn')).show();
            });

            $('.usuario-form').on('submit', function() {
                var $btn = $(this).find('button[type="submit"]');
                $btn.prop('disabled', true);
                $btn.html('<i class="fas fa-spinner fa-spin"></i> Guardando...');
            });
        });
    </script>
}
