@model induccion_refactorization.ViewModels.ReportesViewModel
@{
    ViewBag.Title = "Reportes";
}

<div class="mb-4">
    <a href="@Url.Action("Index", "Admin")" class="btn btn-link ps-0">
        <i class="fas fa-arrow-left"></i> Volver al Panel
    </a>
    <h2 class="mb-1"><i class="fas fa-chart-bar text-primary"></i> Reportes</h2>
    <p class="text-muted mb-0">Estadísticas generales del sistema de inducción.</p>
</div>

<div class="card mb-4" style="overflow: visible;">
    <div class="card-body py-3">
        @using (Html.BeginForm("Reportes", "Admin", FormMethod.Get))
        {
            var carreraIdsFiltro = (int[])ViewBag.CarreraIds;
            var calificadorIdsFiltro = (int[])ViewBag.CalificadorIds;
            var carrerasFiltro = (List<induccion_refactorization.Models.Carrera>)ViewBag.CarrerasFiltro;
            var coordinadoresFiltro = (List<induccion_refactorization.Models.Usuario>)ViewBag.CoordinadoresFiltro;
            var maestrosFiltro = (List<induccion_refactorization.Models.Usuario>)ViewBag.MaestrosFiltro;
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Carrera</label>
                    <div class="dropdown">
                        <button type="button" class="form-select form-select-sm text-start dropdown-toggle" id="carreraDropdownBtn"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            Todas
                        </button>
                        <ul class="dropdown-menu p-2" style="max-height: 250px; overflow-y: auto; min-width: 100%;" aria-labelledby="carreraDropdownBtn">
                            <li>
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="carreraTodasChk" />
                                    <label class="form-check-label fw-semibold" for="carreraTodasChk">Todas</label>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider my-1" /></li>
                            @foreach (var carrera in carrerasFiltro)
                            {
                                <li>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input carrera-checkbox" name="carreraId" value="@carrera.CarreraID" id="carreraChk_@carrera.CarreraID" @(carreraIdsFiltro.Contains(carrera.CarreraID) ? "checked=\"checked\"" : "") />
                                        <label class="form-check-label" for="carreraChk_@carrera.CarreraID">@carrera.Nombre</label>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Periodo</label>
                    @Html.DropDownList("periodoId", (SelectList)ViewBag.PeriodosFiltro, "Todos", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Coordinador / Maestro</label>
                    <div class="dropdown">
                        <button type="button" class="form-select form-select-sm text-start dropdown-toggle" id="calificadorDropdownBtn"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            Todos
                        </button>
                        <ul class="dropdown-menu p-2" style="max-height: 250px; overflow-y: auto; min-width: 100%;" aria-labelledby="calificadorDropdownBtn">
                            <li>
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="calificadorTodosChk" />
                                    <label class="form-check-label fw-semibold" for="calificadorTodosChk">Todos</label>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider my-1" /></li>
                            <li><div class="small text-muted text-uppercase">Coordinadores</div></li>
                            @foreach (var coordinador in coordinadoresFiltro)
                            {
                                <li>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input calificador-checkbox" name="calificadorId" value="@coordinador.UsuarioID" id="calificadorChk_@coordinador.UsuarioID" @(calificadorIdsFiltro.Contains(coordinador.UsuarioID) ? "checked=\"checked\"" : "") />
                                        <label class="form-check-label" for="calificadorChk_@coordinador.UsuarioID">@coordinador.NombreCompleto</label>
                                    </div>
                                </li>
                            }
                            <li><div class="small text-muted text-uppercase mt-1">Maestros</div></li>
                            @foreach (var maestro in maestrosFiltro)
                            {
                                <li>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input calificador-checkbox" name="calificadorId" value="@maestro.UsuarioID" id="calificadorChk_@maestro.UsuarioID" @(calificadorIdsFiltro.Contains(maestro.UsuarioID) ? "checked=\"checked\"" : "") />
                                        <label class="form-check-label" for="calificadorChk_@maestro.UsuarioID">@maestro.NombreCompleto</label>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Estado</label>
                    @{
                        var activoFiltroReporte = ViewBag.Activo as bool?;
                    }
                    <select name="activo" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        @if (activoFiltroReporte == true)
                        {
                            <option value="true" selected="selected">Activos</option>
                        }
                        else
                        {
                            <option value="true">Activos</option>
                        }
                        @if (activoFiltroReporte == false)
                        {
                            <option value="false" selected="selected">Inactivos</option>
                        }
                        else
                        {
                            <option value="false">Inactivos</option>
                        }
                    </select>
                </div>
                <div class="col-md-1 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1" title="Filtrar">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
            <div class="mt-2">
                <a href="@Url.Action("Reportes", "Admin")" class="small">
                    <i class="fas fa-times"></i> Limpiar filtros
                </a>
            </div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Usuarios por Rol</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3 col-sm-6">
                <div class="stat-card">
                    <div class="icon-badge icon-badge-primary"><i class="fas fa-user-shield"></i></div>
                    <div>
                        <div class="stat-card-value">@Model.TotalAdministradores</div>
                        <div class="stat-card-label">Administradores</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="stat-card">
                    <div class="icon-badge icon-badge-primary"><i class="fas fa-users-cog"></i></div>
                    <div>
                        <div class="stat-card-value">@Model.TotalCoordinadores</div>
                        <div class="stat-card-label">Coordinadores</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="stat-card">
                    <div class="icon-badge icon-badge-primary"><i class="fas fa-chalkboard-teacher"></i></div>
                    <div>
                        <div class="stat-card-value">@Model.TotalMaestros</div>
                        <div class="stat-card-label">Maestros</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="stat-card">
                    <div class="icon-badge icon-badge-primary"><i class="fas fa-user-graduate"></i></div>
                    <div>
                        <div class="stat-card-value">@Model.TotalAspirantes</div>
                        <div class="stat-card-label">Aspirantes</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Contenido de Inducción</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4 col-sm-6">
                <div class="stat-card">
                    <div class="icon-badge icon-badge-info"><i class="fas fa-book"></i></div>
                    <div>
                        <div class="stat-card-value">@Model.TotalMaterias</div>
                        <div class="stat-card-label">Materias Activas</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="stat-card">
                    <div class="icon-badge icon-badge-info"><i class="fas fa-list"></i></div>
                    <div>
                        <div class="stat-card-value">@Model.TotalUnidades</div>
                        <div class="stat-card-label">Unidades</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="stat-card">
                    <div class="icon-badge icon-badge-info"><i class="fas fa-file-pdf"></i></div>
                    <div>
                        <div class="stat-card-value">@Model.TotalMateriales</div>
                        <div class="stat-card-label">Materiales</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6 offset-md-4">
                <div class="stat-card">
                    <div class="icon-badge icon-badge-info"><i class="fas fa-file-upload"></i></div>
                    <div>
                        <div class="stat-card-value">@Model.TotalEntregables</div>
                        <div class="stat-card-label">Entregables</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Entregables (Archivos) — Promedio: @(Model.PromedioEntregables?.ToString("F2") ?? "N/A")</div>
            <div class="card-body">
                <div class="row g-3 text-center">
                    <div class="col-4">
                        <div class="icon-badge icon-badge-warning mx-auto mb-2"><i class="fas fa-clock"></i></div>
                        <div class="stat-card-value">@Model.EntregasPendientes</div>
                        <div class="stat-card-label">Pendientes</div>
                    </div>
                    <div class="col-4">
                        <div class="icon-badge icon-badge-success mx-auto mb-2"><i class="fas fa-check-circle"></i></div>
                        <div class="stat-card-value">@Model.EntregasRevisadas</div>
                        <div class="stat-card-label">Revisadas</div>
                    </div>
                    <div class="col-4">
                        <div class="icon-badge icon-badge-danger mx-auto mb-2"><i class="fas fa-times-circle"></i></div>
                        <div class="stat-card-value">@Model.EntregasRechazadas</div>
                        <div class="stat-card-label">Rechazadas</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Unidades — Promedio: @(Model.PromedioUnidades?.ToString("F2") ?? "N/A")</div>
            <div class="card-body">
                <div class="row g-3 text-center">
                    <div class="col-4">
                        <div class="icon-badge icon-badge-info mx-auto mb-2"><i class="fas fa-tasks"></i></div>
                        <div class="stat-card-value">@Model.UnidadesAsignadas</div>
                        <div class="stat-card-label">Asignadas</div>
                    </div>
                    <div class="col-4">
                        <div class="icon-badge icon-badge-warning mx-auto mb-2"><i class="fas fa-hourglass-half"></i></div>
                        <div class="stat-card-value">@Model.UnidadesEntregadas</div>
                        <div class="stat-card-label">Entregadas</div>
                    </div>
                    <div class="col-4">
                        <div class="icon-badge icon-badge-success mx-auto mb-2"><i class="fas fa-star"></i></div>
                        <div class="stat-card-value">@Model.UnidadesCalificadas</div>
                        <div class="stat-card-label">Calificadas</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Progreso por Materia</div>
    <div class="card-body p-0">
        @if (Model.MateriasConProgreso.Any())
        {
            <div class="table-responsive">
                <table class="table table-clean mb-0">
                    <thead>
                        <tr>
                            <th>Materia</th>
                            <th style="width: 55%;">Progreso</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var materia in Model.MateriasConProgreso)
                        {
                            <tr>
                                <td data-label="Materia">@materia.Nombre</td>
                                <td data-label="Progreso">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @(materia.Porcentaje)%;"></div>
                                        </div>
                                        <small class="text-muted">@materia.Porcentaje% (@materia.Completados/@materia.Total)</small>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="icon-badge icon-badge-lg icon-badge-info">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="empty-state-title">Sin datos todavía</div>
                <p class="mb-0">Aún no hay progreso registrado.</p>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            function setupTodosToggle(todosId, itemsSelector, buttonId, todosLabel) {
                var todosChk = document.getElementById(todosId);
                var itemChks = document.querySelectorAll(itemsSelector);
                var button = document.getElementById(buttonId);

                function updateButtonLabel() {
                    if (todosChk.checked) {
                        button.textContent = todosLabel;
                        return;
                    }
                    var checked = Array.from(itemChks).filter(function (chk) { return chk.checked; });
                    if (checked.length === 0) {
                        button.textContent = todosLabel;
                    } else if (checked.length === 1) {
                        button.textContent = checked[0].nextElementSibling.textContent;
                    } else {
                        button.textContent = checked.length + ' seleccionados';
                    }
                }

                function applyTodosState() {
                    itemChks.forEach(function (chk) {
                        chk.disabled = todosChk.checked;
                        if (todosChk.checked) {
                            chk.checked = false;
                        }
                    });
                    updateButtonLabel();
                }

                // Al cargar: si no hay nada seleccionado individualmente, "Todas/Todos"
                // empieza marcado (equivalente a no filtrar).
                var anyChecked = Array.from(itemChks).some(function (chk) { return chk.checked; });
                todosChk.checked = !anyChecked;
                applyTodosState();

                todosChk.addEventListener('change', applyTodosState);

                itemChks.forEach(function (chk) {
                    chk.addEventListener('change', function () {
                        if (chk.checked) {
                            todosChk.checked = false;
                        }
                        updateButtonLabel();
                    });
                });
            }

            setupTodosToggle('carreraTodasChk', '.carrera-checkbox', 'carreraDropdownBtn', 'Todas');
            setupTodosToggle('calificadorTodosChk', '.calificador-checkbox', 'calificadorDropdownBtn', 'Todos');
        });
    </script>
}
