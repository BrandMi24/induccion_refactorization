@model List<induccion_refactorization.Models.Periodo>
@{
    ViewBag.Title = "Gestión de Periodos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="fas fa-calendar-alt text-primary"></i> Gestión de Periodos</h2>
        <p class="text-muted mb-0">Bienvenido, <strong>@ViewBag.NombreCompleto</strong></p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoPeriodo">
        <i class="fas fa-calendar-plus"></i> Nuevo Periodo
    </button>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Periodos Registrados</h5>
        <small class="text-muted">@Model.Count resultado(s)</small>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-clean mb-0">
                    <thead>
                        <tr>
                            <th>Periodo</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin</th>
                            <th class="text-center">Materias Asignadas</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var periodo in Model)
                        {
                            <tr>
                                <td data-label="Periodo">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="icon-badge icon-badge-sm icon-badge-primary">
                                            <i class="fas fa-calendar-alt"></i>
                                        </div>
                                        <div class="fw-semibold">@periodo.Nombre</div>
                                    </div>
                                </td>
                                <td data-label="Fecha Inicio">@periodo.FechaInicio.ToString("dd/MM/yyyy")</td>
                                <td data-label="Fecha Fin">@periodo.FechaFin.ToString("dd/MM/yyyy")</td>
                                <td class="text-center" data-label="Materias Asignadas">@periodo.Ind_Materias.Count</td>
                                <td class="text-center" data-label="Estado">
                                    @if (periodo.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end" data-label="Acciones">
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon"
                                            title="Editar Periodo"
                                            data-bs-toggle="modal" data-bs-target="#modalEditarPeriodo"
                                            data-id="@periodo.PeriodoID"
                                            data-fecha-inicio="@periodo.FechaInicio.ToString("yyyy-MM-dd")"
                                            data-fecha-fin="@periodo.FechaFin.ToString("yyyy-MM-dd")"
                                            data-activo="@periodo.Activo.ToString().ToLower()">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    @using (Html.BeginForm("TogglePeriodo", "Admin", new { id = periodo.PeriodoID }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-icon @(periodo.Activo ? "btn-outline-danger" : "btn-outline-success")"
                                                title="@(periodo.Activo ? "Desactivar" : "Reactivar")"
                                                onclick="return confirm('¿Está seguro de @(periodo.Activo ? "desactivar" : "reactivar") este periodo?');">
                                            <i class="fas @(periodo.Activo ? "fa-toggle-off" : "fa-toggle-on")"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="icon-badge icon-badge-lg icon-badge-info">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div class="empty-state-title">No hay periodos registrados</div>
                <p class="mb-0">Crea el primer periodo para que los coordinadores puedan asignarlo a sus materias.</p>
            </div>
        }
    </div>
</div>

@* ===================== Modal: Nuevo Periodo ===================== *@
<div class="modal fade" id="modalNuevoPeriodo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("CreatePeriodo", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-calendar-plus"></i> Nuevo Periodo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="control-label">Fecha de Inicio</label>
                            <input type="date" name="FechaInicio" class="form-control" required />
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="control-label">Fecha de Fin</label>
                            <input type="date" name="FechaFin" class="form-control" required />
                        </div>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="createPeriodoActivo" name="Activo" value="true" checked="checked" />
                        <label class="form-check-label" for="createPeriodoActivo">Periodo activo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Periodo</button>
                </div>
            }
        </div>
    </div>
</div>

@* ===================== Modal: Editar Periodo ===================== *@
<div class="modal fade" id="modalEditarPeriodo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("EditPeriodo", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="PeriodoID" id="editPeriodoId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-calendar-alt"></i> Editar Periodo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="control-label">Fecha de Inicio</label>
                            <input type="date" name="FechaInicio" id="editPeriodoFechaInicio" class="form-control" required />
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="control-label">Fecha de Fin</label>
                            <input type="date" name="FechaFin" id="editPeriodoFechaFin" class="form-control" required />
                        </div>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="editPeriodoActivo" name="Activo" value="true" />
                        <label class="form-check-label" for="editPeriodoActivo">Periodo activo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Cambios</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            document.getElementById('modalEditarPeriodo').addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('editPeriodoId').value = button.dataset.id;
                document.getElementById('editPeriodoFechaInicio').value = button.dataset.fechaInicio;
                document.getElementById('editPeriodoFechaFin').value = button.dataset.fechaFin;
                document.getElementById('editPeriodoActivo').checked = button.dataset.activo === 'true';
            });
        });
    </script>
}
