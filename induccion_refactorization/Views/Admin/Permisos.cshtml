@using induccion_refactorization.Models
@{
    ViewBag.Title = "Permisos por Rol";
    var roles = (List<Role>)ViewBag.Roles;
    var rolSeleccionado = (Role)ViewBag.RolSeleccionado;
    var permisos = (List<induccion_refactorization.Models.Ind_Permiso>)ViewBag.Permisos;
    var permisosRol = (List<Ind_RolPermiso>)ViewBag.PermisosRol;
    var rolesOriginales = (int[])ViewBag.RolesOriginales;
    bool puedeCrear = ViewBag.PuedeCrear;
    bool puedeEditar = ViewBag.PuedeEditar;
    bool puedeEliminar = ViewBag.PuedeEliminar;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <a href="@Url.Action("GestionUsuarios", "Admin")" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="fas fa-arrow-left"></i> Volver a Gestión de Usuarios
        </a>
        <h2 class="mb-1"><i class="fas fa-shield-alt text-primary"></i> Permisos por Rol</h2>
        <p class="text-muted mb-0">Define qué puede leer, crear, editar y eliminar cada rol en cada sección del sistema.</p>
    </div>
    @if (puedeCrear)
    {
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoRol">
            <i class="fas fa-plus"></i> Nuevo Rol
        </button>
    }
</div>

<div class="card mb-3" style="overflow: visible;">
    <div class="card-body py-3">
        @using (Html.BeginForm("Permisos", "Admin", FormMethod.Get))
        {
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Rol</label>
                    <select name="rolId" class="form-select" onchange="this.form.submit()">
                        @foreach (var rol in roles)
                        {
                            var etiqueta = rol.Nombre + (rol.Activo ? "" : " (inactivo)");
                            if (rolSeleccionado != null && rol.RolID == rolSeleccionado.RolID)
                            {
                                <option value="@rol.RolID" selected="selected">@etiqueta</option>
                            }
                            else
                            {
                                <option value="@rol.RolID">@etiqueta</option>
                            }
                        }
                    </select>
                </div>
            </div>
        }
    </div>
</div>

@if (rolSeleccionado == null)
{
    <div class="empty-state">
        <div class="icon-badge icon-badge-lg icon-badge-info"><i class="fas fa-shield-alt"></i></div>
        <div class="empty-state-title">No hay roles configurados</div>
        <p class="mb-0">Crea un rol para empezar a definir sus permisos.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0">
                Permisos de <strong>@rolSeleccionado.Nombre</strong>
                @if (!rolSeleccionado.Activo)
                {
                    <span class="badge bg-secondary ms-2">Inactivo</span>
                }
            </h5>
            @if (puedeEliminar && !rolesOriginales.Contains(rolSeleccionado.RolID))
            {
                <div class="d-flex gap-2">
                    @using (Html.BeginForm("ToggleRol", "Admin", new { id = rolSeleccionado.RolID }, FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="btn btn-sm @(rolSeleccionado.Activo ? "btn-outline-danger" : "btn-outline-success")"
                                onclick="return confirm('¿Está seguro de @(rolSeleccionado.Activo ? "desactivar" : "reactivar") este rol?');">
                            <i class="fas @(rolSeleccionado.Activo ? "fa-ban" : "fa-check")"></i>
                            @(rolSeleccionado.Activo ? "Desactivar Rol" : "Reactivar Rol")
                        </button>
                    }
                    @using (Html.BeginForm("DeleteRol", "Admin", new { id = rolSeleccionado.RolID }, FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('¿Está seguro de ELIMINAR PERMANENTEMENTE el rol \'@rolSeleccionado.Nombre\'? Esta acción no se puede deshacer. Solo funciona si ya no tiene usuarios asignados.');">
                            <i class="fas fa-trash"></i> Eliminar Rol
                        </button>
                    }
                </div>
            }
            else if (rolesOriginales.Contains(rolSeleccionado.RolID))
            {
                <span class="small text-muted"><i class="fas fa-lock"></i> Rol original del sistema, no se puede desactivar ni eliminar.</span>
            }
        </div>
        <div class="card-body p-0">
            @using (Html.BeginForm("GuardarPermisosRol", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="rolId" value="@rolSeleccionado.RolID" />
                <div class="table-responsive">
                    <table class="table table-hover table-clean mb-0">
                        <thead>
                            <tr>
                                <th>Sección</th>
                                <th class="text-center">Leer</th>
                                <th class="text-center">Crear</th>
                                <th class="text-center">Editar</th>
                                <th class="text-center">Eliminar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var idx = 0; }
                            @foreach (var permiso in permisos)
                            {
                                var actual = permisosRol.FirstOrDefault(rp => rp.PermisoID == permiso.PermisoID);
                                <tr>
                                    <td data-label="Sección">
                                        <div class="fw-semibold">@permiso.Nombre</div>
                                        @if (!string.IsNullOrWhiteSpace(permiso.Descripcion))
                                        {
                                            <small class="text-muted">@permiso.Descripcion</small>
                                        }
                                        <input type="hidden" name="permisos[@idx].PermisoID" value="@permiso.PermisoID" />
                                    </td>
                                    <td class="text-center" data-label="Leer">
                                        <input type="checkbox" class="form-check-input" name="permisos[@idx].Leer" value="true" checked="@(actual != null && actual.PuedeLeer ? "checked" : null)" disabled="@(puedeEditar ? null : "disabled")" />
                                    </td>
                                    <td class="text-center" data-label="Crear">
                                        <input type="checkbox" class="form-check-input" name="permisos[@idx].Crear" value="true" checked="@(actual != null && actual.PuedeCrear ? "checked" : null)" disabled="@(puedeEditar ? null : "disabled")" />
                                    </td>
                                    <td class="text-center" data-label="Editar">
                                        <input type="checkbox" class="form-check-input" name="permisos[@idx].Editar" value="true" checked="@(actual != null && actual.PuedeEditar ? "checked" : null)" disabled="@(puedeEditar ? null : "disabled")" />
                                    </td>
                                    <td class="text-center" data-label="Eliminar">
                                        <input type="checkbox" class="form-check-input" name="permisos[@idx].Eliminar" value="true" checked="@(actual != null && actual.PuedeEliminar ? "checked" : null)" disabled="@(puedeEditar ? null : "disabled")" />
                                    </td>
                                </tr>
                                idx++;
                            }
                        </tbody>
                    </table>
                </div>
                if (puedeEditar)
                {
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Permisos</button>
                    </div>
                }
            }
        </div>
    </div>
}

@* ===================== Modal: Nuevo Rol ===================== *@
<div class="modal fade" id="modalNuevoRol" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("CreateRol", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-shield-alt"></i> Nuevo Rol</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="control-label">Nombre del Rol</label>
                        <input type="text" name="nombre" class="form-control" required />
                    </div>
                    <p class="small text-muted mb-0">
                        El rol se crea sin permisos asignados. Después de crearlo, selecciónalo arriba
                        para definir qué puede hacer en cada sección.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Crear Rol</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $('.alert.alert-dismissible').fadeOut('slow');
            }, 5000);
        });
    </script>
}
