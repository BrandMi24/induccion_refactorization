@model induccion_refactorization.Models.Usuario
@{
    ViewBag.Title = "Mi Perfil";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-3">
            <h4 class="mb-0"><i class="fas fa-user-circle text-primary"></i> Mi Perfil</h4>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="icon-badge icon-badge-lg icon-badge-primary">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <div class="fw-semibold fs-5">@Model.NombreCompleto</div>
                        <span class="badge bg-info">@(Model.Role?.Nombre)</span>
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Usuario</dt>
                    <dd class="col-sm-8">@Model.NombreUsuario</dd>

                    <dt class="col-sm-4 text-muted">Correo electrónico</dt>
                    <dd class="col-sm-8">@Model.CorreoElectronico</dd>

                    <dt class="col-sm-4 text-muted">Teléfono</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Telefono) ? "Sin registrar" : Model.Telefono)</dd>

                    <dt class="col-sm-4 text-muted">Miembro desde</dt>
                    <dd class="col-sm-8">@(Model.FechaRegistro?.ToString("dd/MM/yyyy") ?? "N/A")</dd>
                </dl>

                <hr />

                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalEditarPerfil">
                    <i class="fas fa-edit"></i> Editar Perfil
                </button>
            </div>
        </div>
    </div>
</div>

@* ===================== Modal: Editar Perfil ===================== *@
<div class="modal fade" id="modalEditarPerfil" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("Edit", "Perfil", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-user-edit"></i> Editar Perfil</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="form-label">Nombre</label>
                            <input type="text" name="nombre" class="form-control" value="@Model.Nombre" required />
                        </div>
                        <div class="col-md-3 form-group mb-3">
                            <label class="form-label">Apellido Paterno</label>
                            <input type="text" name="apellidoPaterno" class="form-control" value="@Model.ApellidoPaterno" required />
                        </div>
                        <div class="col-md-3 form-group mb-3">
                            <label class="form-label">Apellido Materno</label>
                            <input type="text" name="apellidoMaterno" class="form-control" value="@Model.ApellidoMaterno" />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Teléfono</label>
                        <input type="text" name="telefono" class="form-control" value="@Model.Telefono" maxlength="10" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label text-muted">Correo electrónico</label>
                        <input type="email" class="form-control" value="@Model.CorreoElectronico" disabled />
                        <small class="text-muted">Contacta al administrador para cambiar tu correo.</small>
                    </div>
                    <hr />
                    <div class="form-group">
                        <label class="form-label">Nueva Contraseña</label>
                        <input type="password" name="nuevaContrasena" class="form-control" placeholder="Dejar en blanco para no cambiar" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Cambios</button>
                </div>
            }
        </div>
    </div>
</div>
